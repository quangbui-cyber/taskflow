# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next.nosync/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example chỉ là mẫu (không có giá trị thật) — cần commit để người khác
# biết app cần những biến môi trường nào.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# ảnh chụp & ghi chú review tạm thời (không phải mã nguồn app)
/audit-navigation/
design-qa.md
admin-accounts-*.png

# kết quả audit / tài liệu xuất ra từ công cụ (không phải mã nguồn app)
/outputs/
/.codex/

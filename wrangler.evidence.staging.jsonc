{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taskflow-evidence-staging-cpu-20261013",
  "main": "cloudflare/evidence-object.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "EVIDENCE_OBJECTS",
        "class_name": "EvidenceObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "staging-free-evidence-v1",
      "new_sqlite_classes": ["EvidenceObject"]
    }
  ],
  "observability": {
    "enabled": true
  }
}

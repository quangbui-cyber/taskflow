{
  "name": "mycreative",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "TZ=Asia/Ho_Chi_Minh next dev --webpack",
    "clean": "rm -rf .next .next.nosync",
    "build": "prisma generate && node scripts/deploy-migrations.mjs && next build --webpack",
    "build:app": "prisma generate && next build --webpack",
    "build:cloudflare": "cross-env TASKFLOW_DIST_DIR=.next node scripts/build-cloudflare.mjs",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "db:migrate:deploy": "node scripts/deploy-migrations.mjs --force",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "TZ=Asia/Ho_Chi_Minh next start",
    "lint": "eslint",
    "test:costflow": "node scripts/test-costflow.mjs",
    "postinstall": "prisma generate",
    "seed": "prisma db seed",
    "seed:quotation-templates": "tsx scripts/seed-quotation-templates.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@neondatabase/serverless": "1.2.0",
    "@opennextjs/cloudflare": "^1.19.1",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "bcryptjs": "^3.0.3",
    "exceljs": "4.4.0",
    "jose": "^6.2.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "nodemailer": "^7.0.13",
    "pdfjs-dist": "^5.4.296",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  }
}

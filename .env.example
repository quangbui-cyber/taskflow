# Sao chép file này thành .env rồi điền giá trị thật.
#
# ⚠️ TUYỆT ĐỐI KHÔNG đặt tên file là .env.production / .env.development / .env.test
# Đó là tên dành riêng của Next.js: `next start` và `next build` chạy với
# NODE_ENV=production nên sẽ TỰ ĐỘNG nạp .env.production và nó GHI ĐÈ .env.
# Hậu quả: chạy app trên máy cá nhân lại âm thầm kết nối vào database thật.
# Muốn giữ chuỗi kết nối production để chạy migration, hãy dùng tên trung tính
# như .env.neon rồi nạp thủ công khi cần:  set -a; source .env.neon; set +a

# Chuỗi kết nối PostgreSQL.
# - Dev cục bộ:  postgresql://<user>@localhost:5432/taskflow
# - Neon:        postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=""

# Chuỗi bí mật ký session — tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Tài khoản admin production (dùng với: SEED_MODE=admin npm run seed)
ADMIN_NAME="Quản trị viên"
ADMIN_EMAIL="admin@congty.com"
ADMIN_PASSWORD="đổi-mật-khẩu-này"

# Múi giờ hiển thị. Khi deploy Vercel, thêm biến TZ=Asia/Ho_Chi_Minh
# để giờ hạn chót không bị lệch (server Vercel mặc định chạy UTC).
TZ="Asia/Ho_Chi_Minh"

# Webhook của phòng Google Chat nhận các lời cảm ơn công khai từ Góc cảm ơn.
# Đây là thông tin bí mật: không commit URL thật vào Git.
GOOGLE_CHAT_RECOGNITION_WEBHOOK_URL=""

# Chuỗi bí mật bảo vệ cron job nhắc việc hàng ngày (9h sáng, gửi Google Chat).
# Vercel tự gửi kèm header Authorization: Bearer <giá trị này> khi chạy cron.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Bỏ trống thì endpoint cron luôn trả 401 (an toàn mặc định).
CRON_SECRET=""

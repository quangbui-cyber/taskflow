# Sao chép file này thành .env rồi điền giá trị thật.
#
# ⚠️ TUYỆT ĐỐI KHÔNG đặt tên file là .env.production / .env.development / .env.test
# Đó là tên dành riêng của Next.js: `next start` và `next build` chạy với
# NODE_ENV=production nên sẽ TỰ ĐỘNG nạp .env.production và nó GHI ĐÈ .env.
# Hậu quả: chạy app trên máy cá nhân lại âm thầm kết nối vào database thật.
# Muốn giữ chuỗi kết nối production để chạy migration, hãy dùng tên trung tính
# như .env.neon rồi nạp thủ công khi cần:  set -a; source .env.neon; set +a

# Chuỗi kết nối PostgreSQL.
# - Dev cục bộ:  postgresql://<user>@localhost:5432/taskflow
# - Neon:        postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=""

# Chuỗi bí mật ký session — tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Tài khoản admin production (dùng với: SEED_MODE=admin npm run seed)
ADMIN_NAME="Quản trị viên"
ADMIN_EMAIL="admin@congty.com"
ADMIN_PASSWORD="đổi-mật-khẩu-này"

# Múi giờ hiển thị. Khi deploy Vercel, thêm biến TZ=Asia/Ho_Chi_Minh
# để giờ hạn chót không bị lệch (server Vercel mặc định chạy UTC).
TZ="Asia/Ho_Chi_Minh"

# Webhook của phòng Google Chat nhận các lời cảm ơn công khai từ Góc cảm ơn.
# Đây là thông tin bí mật: không commit URL thật vào Git.
GOOGLE_CHAT_RECOGNITION_WEBHOOK_URL=""

# Chuỗi bí mật bảo vệ cron job nhắc việc hàng ngày (9h sáng, gửi Google Chat).
# Vercel tự gửi kèm header Authorization: Bearer <giá trị này> khi chạy cron.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Bỏ trống thì endpoint cron luôn trả 401 (an toàn mặc định).
CRON_SECRET=""

# Web Push: tạo một cặp khóa và giữ cố định qua các lần deploy.
# node -e "console.log(require('web-push').generateVAPIDKeys())"
# Chỉ public key được đưa vào trình duyệt; private key luôn ở server.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:quang.bui@creativestation.vn"

# Gửi email lịch họp và nghỉ phép qua Gmail / Google Workspace SMTP.
# Bỏ trống thì app vẫn chạy bình thường,
# chỉ không gửi email (thông báo trong app vẫn có).
# - SMTP_USER: hộp thư riêng cho app, ví dụ noreply@creativestation.vn.
# - SMTP_APP_PASSWORD: "Mật khẩu ứng dụng" 16 ký tự, tạo tại
#   https://myaccount.google.com/apppasswords (tài khoản phải bật xác minh 2 bước).
#   Đây là thông tin bí mật: không commit giá trị thật vào Git.
SMTP_USER=""
SMTP_APP_PASSWORD=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
# Tên hiển thị của người gửi (mặc định: myCreative).
MAIL_FROM_NAME=""
# Địa chỉ app để dẫn link trong email, ví dụ https://app.congty.vn
# Trên Vercel có thể bỏ trống — app tự lấy tên miền production.
APP_URL=""

# Đăng nhập bằng mọi tài khoản Google (không giới hạn Google Workspace).
# Tạo OAuth Client loại Web application trong Google Cloud Console.
# Authorized redirect URI: https://ten-mien-app/api/auth/google/callback
# Với local, thêm: http://localhost:3000/api/auth/google/callback
# Bỏ trống một trong hai biến thì nút Google được ẩn; email/mật khẩu vẫn hoạt động.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Kho lưu trữ Google Drive (tuỳ chọn, có giá trị mặc định). Kết nối ở Cài đặt → Lưu trữ.
# GOOGLE_DRIVE_SHARED_DRIVE_ID="0AL-5HJ8czOkOUk9PVA"
# GOOGLE_DRIVE_ACCOUNT="noreply@creativestation.vn"
# Cùng OAuth client này dùng để tạo link Google Meet khi đặt lịch họp (xem DEPLOY.md).
# Thêm redirect URI: https://ten-mien-app/api/google/meet/callback và bật Google Meet REST API.

# Biên bản họp bằng AI (tuỳ chọn, xem DEPLOY.md mục "Biên bản họp bằng AI").
# Cần đủ cả ba: GROQ_API_KEY (chép lời), GEMINI_API_KEY (viết biên bản) và
# BLOB_READ_WRITE_TOKEN (kho Vercel Blob riêng tư, Vercel tự thêm khi kết nối store).
# Đây là thông tin bí mật: không commit giá trị thật vào Git.
GROQ_API_KEY=""
GEMINI_API_KEY=""
BLOB_READ_WRITE_TOKEN=""
# Hạn mức chống chạy quá tay (số nguyên dương, để trống = mặc định):
# độ dài tối đa mỗi file (phút, mặc định 180), tổng phút chép lời/ngày (600),
# tổng lượt viết biên bản/ngày (60).
RECAP_MAX_AUDIO_MINUTES=""
RECAP_DAILY_AUDIO_MINUTES=""
RECAP_DAILY_SUMMARIES=""
# Tuỳ chọn: đổi model không cần sửa code; MEETING_RECAPS_ENABLED=false để tắt.
RECAP_TRANSCRIBE_MODEL=""
RECAP_SUMMARY_MODEL=""
# Tuỳ chọn: mức suy nghĩ khi viết biên bản (low | medium | high, mặc định medium)
# và trần token trả về mỗi lượt, gồm cả phần suy nghĩ (mặc định 24576).
RECAP_SUMMARY_THINKING=""
RECAP_SUMMARY_MAX_OUTPUT_TOKENS=""
MEETING_RECAPS_ENABLED=""

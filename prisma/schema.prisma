generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  name                 String
  avatarUrl            String?
  passwordHash         String
  sessionVersion       Int                 @default(0)
  role                 String              @default("USER") // "ADMIN" | "ACCOUNT" | "USER"
  isActive             Boolean             @default(true)
  deactivatedAt        DateTime?
  managerId            String? // người quản lý trực tiếp
  manager              User?               @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports              User[]              @relation("TeamManager") // nhân viên dưới quyền
  createdAt            DateTime            @default(now())
  memberships          ProjectMember[]
  ownedProjects        Project[]           @relation("ProjectOwner")
  assignedTasks        Task[]              @relation("TaskAssignee")
  createdTasks         Task[]              @relation("TaskCreator")
  comments             Comment[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  taskFollows          TaskFollower[]
  accountProfile       Account?
  groupMemberships     MemberGroupMember[]
  uploadedFiles        ProjectFile[]       @relation("ProjectFileUploader")
  uploadedTaskFiles    TaskFile[]          @relation("TaskFileUploader")
  recognitionsSent     Recognition[]       @relation("RecognitionSender")
  recognitionsReceived Recognition[]       @relation("RecognitionRecipient")
  organizedMeetings    Meeting[]           @relation("MeetingOrganizer")
  meetingInvites       MeetingAttendee[]
  kpiPlanChanges       KpiPlanChange[]
  uploadedDocuments    DocumentFile[]      @relation("DocumentFileUploader")
  createdDocumentLinks DocumentLink[]      @relation("DocumentLinkCreator")
  annualLeaveDays      Float               @default(12) // số ngày phép năm do Admin đặt
  // Quản lý nghỉ phép: duyệt đơn của người chưa có quản lý, nhận thông báo kết quả mọi đơn
  isLeaveManager       Boolean             @default(false)
  leaveRequests        LeaveRequest[]      @relation("LeaveRequester")
  leaveDecisions       LeaveRequest[]      @relation("LeaveDecider")
  leaveAdjustments     LeaveUsageAdjustment[]

  @@index([isActive])
}

// Mỗi trình duyệt/thiết bị đăng ký riêng; endpoint chỉ thuộc một tài khoản.
model PushSubscription {
  id             String    @id @default(cuid())
  endpoint       String    @unique
  p256dh         String
  auth           String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionVersion Int
  lastTestAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

enum ProjectCategory {
  CLIENT
  INTERNAL
}

model Project {
  id                   String          @id @default(cuid())
  name                 String
  description          String?
  category             ProjectCategory @default(CLIENT)
  purchaseOrderNumber  String?         @unique
  color                String          @default("#6366f1")
  status               String          @default("BIDDING") // "BIDDING" | "ON_PROCESS" | "PENDING" | "DONE" | "CANCEL" | "FAIL"
  type                 String          @default("OTHER") // "TEAMBUILDING" | "MICE" | "ACTIVATION" | "EVENT" | "PUR" | "OTHER"
  executionStartAt     DateTime? // ngày bắt đầu thực hiện (chạy event)
  executionEndAt       DateTime? // ngày kết thúc — null nếu chỉ 1 ngày
  revenue              Float           @default(0) // doanh thu dự kiến/thực tế (VND)
  googleChatWebhookUrl String?
  ownerId              String
  owner                User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  clientId             String?
  client               Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  accountId            String?
  account              Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  responsibleTeamId    String?
  responsibleTeam      SalesTeam?      @relation(fields: [responsibleTeamId], references: [id], onDelete: SetNull)
  responsibleGroupId   String?
  responsibleGroup     MemberGroup?    @relation(fields: [responsibleGroupId], references: [id], onDelete: SetNull)
  members              ProjectMember[]
  tasks                Task[]
  files                ProjectFile[]
  onProcessAt          DateTime? // thời điểm đầu tiên chuyển sang ON_PROCESS - dùng ghi nhận doanh thu
  completedAt          DateTime? // thời điểm chuyển sang DONE
  createdAt            DateTime        @default(now())

  @@index([status, onProcessAt])
  @@index([status, completedAt])
  @@index([executionStartAt])
  @@index([responsibleTeamId])
  @@index([responsibleGroupId])
}

// Danh mục khách hàng — do admin tạo sẵn
model Client {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  projects  Project[]
}

// Danh mục account (đầu mối phụ trách) — do admin tạo sẵn
model Account {
  id         String             @id @default(cuid())
  name       String
  userId     String?            @unique
  user       User?              @relation(fields: [userId], references: [id], onDelete: Restrict)
  teamId     String
  team       SalesTeam          @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdAt  DateTime           @default(now())
  projects   Project[]
  ledTeam    SalesTeam?         @relation("SalesTeamLeader")
  kpiTargets KpiAccountTarget[]

  @@index([teamId])
}

// Team kinh doanh — dùng nhóm các Account để theo dõi hiệu suất
model SalesTeam {
  id         String          @id @default(cuid())
  name       String          @unique
  createdAt  DateTime        @default(now())
  accounts   Account[]
  projects   Project[]
  // Trưởng team: Account được quyền chia KPI team xuống từng Account
  leaderId   String?         @unique
  leader     Account?        @relation("SalesTeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  kpiTargets KpiTeamTarget[]
}

// Kế hoạch KPI doanh số theo năm. Chỉ tiêu tháng của công ty = tổng chỉ tiêu các team.
model KpiPlan {
  id             String             @id @default(cuid())
  year           Int                @unique
  companyTarget  Float              @default(0) // KPI doanh số cả năm của công ty (VND)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  // Đã chốt: không ai sửa được chỉ tiêu cho tới khi Admin mở lại
  lockedAt       DateTime?
  changes        KpiPlanChange[]
  teamTargets    KpiTeamTarget[]
  accountTargets KpiAccountTarget[]
}

// Nhật ký thay đổi kế hoạch KPI: ai lưu, chốt hay mở lại, lúc nào
model KpiPlanChange {
  id        String   @id @default(cuid())
  planId    String
  plan      KpiPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String // giữ tên tại thời điểm thay đổi, kể cả khi user bị xoá
  summary   String
  createdAt DateTime @default(now())

  @@index([planId, createdAt])
}

// Admin giao KPI cho team theo tháng
model KpiTeamTarget {
  id     String    @id @default(cuid())
  planId String
  plan   KpiPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  teamId String
  team   SalesTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  month  Int // 1-12
  amount Float     @default(0)

  @@unique([planId, teamId, month])
  @@index([teamId])
}

// Trưởng team chia KPI team xuống từng Account theo tháng
model KpiAccountTarget {
  id        String  @id @default(cuid())
  planId    String
  plan      KpiPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  month     Int // 1-12
  amount    Float   @default(0)

  @@unique([planId, accountId, month])
  @@index([accountId])
}

// Phòng ban / nhóm phụ trách dự án và thêm nhiều thành viên trong một lần
model MemberGroup {
  id        String              @id @default(cuid())
  name      String              @unique
  createdAt DateTime            @default(now())
  members   MemberGroupMember[]
  projects  Project[]
}

model MemberGroupMember {
  id        String      @id @default(cuid())
  groupId   String
  userId    String
  group     MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member") // "owner" | "member"
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model ProjectFile {
  id         String   @id @default(cuid())
  projectId  String
  uploaderId String?
  name       String
  mimeType   String
  size       Int
  data       Bytes
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader   User?    @relation("ProjectFileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([uploaderId])
}

model Task {
  id            String         @id @default(cuid())
  title         String
  description   String?
  result        String? // kết quả/bàn giao sau khi hoàn thành công việc
  status        String         @default("TODO") // "TODO" | "IN_PROGRESS" | "DONE"
  priority      String         @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"
  dueDate       DateTime?
  completedAt   DateTime? // thời điểm chuyển sang DONE — dùng tính đúng hạn/trễ hạn
  order         Float          @default(0)
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId    String?
  assignee      User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId     String
  creator       User           @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  comments      Comment[]
  followers     TaskFollower[]
  notifications Notification[]
  files         TaskFile[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// Tệp đính kèm của task — BRIEF khi giao việc, RESULT khi bàn giao kết quả
model TaskFile {
  id         String   @id @default(cuid())
  taskId     String
  uploaderId String?
  kind       String // "BRIEF" | "RESULT"
  name       String
  mimeType   String
  size       Int
  data       Bytes
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader   User?    @relation("TaskFileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([uploaderId])
}

// Người theo dõi task — nhận thông báo khi task có bình luận hoặc thay đổi quan trọng
model TaskFollower {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
}

model Notification {
  id            String       @id @default(cuid())
  dedupeKey     String?      @unique // chống tạo trùng cho thông báo tự động
  userId        String // người nhận
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String // "TASK_ASSIGNED" | "TASK_COMPLETED" | "TASK_UPDATED" | "COMMENT" | "COMMENT_MENTION" | "TASK_FOLLOW" | "DEADLINE_REMINDER" | "RECOGNITION_RECEIVED"
  message       String
  taskId        String?
  task          Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId     String? // để dẫn link tới board
  recognitionId String?
  recognition   Recognition? @relation("RecognitionNotification", fields: [recognitionId], references: [id], onDelete: SetNull)
  meetingId     String? // để dẫn link tới lịch họp
  meeting       Meeting?     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  read          Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([recognitionId])
  @@index([meetingId])
}

// Lời cảm ơn độc lập với project — dùng để mọi người ghi nhận nhau trong công việc và cuộc sống.
model Recognition {
  id            String         @id @default(cuid())
  senderId      String
  recipientId   String
  message       String
  category      String         @default("KINDNESS") // KINDNESS | SUPPORT | INSPIRATION | CARE
  visibility    String         @default("COMPANY") // COMPANY | PRIVATE
  sender        User           @relation("RecognitionSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient     User           @relation("RecognitionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  notifications Notification[] @relation("RecognitionNotification")
  createdAt     DateTime       @default(now())

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@index([visibility, createdAt])
}

// Cấu hình tích hợp dùng chung. Giá trị nhạy cảm được mã hóa trước khi lưu.
model IntegrationSetting {
  key            String   @id
  encryptedValue String
  updatedAt      DateTime @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  mentions  Json     @default("[]")
  body      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Bộ đếm đăng nhập sai, lưu theo khóa HMAC của email/IP để không lưu thêm PII.
// Dùng database thay vì bộ nhớ tiến trình để rate limit hoạt động trên nhiều instance.
model LoginRateLimit {
  key             String    @id
  failures        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}

// Bộ hồ sơ dùng chung toàn công ty (hồ sơ mẫu, hồ sơ thanh toán...)
model DocumentSet {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  createdAt   DateTime       @default(now())
  files       DocumentFile[]
  links       DocumentLink[]
}

model DocumentFile {
  id         String      @id @default(cuid())
  setId      String
  set        DocumentSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  title      String // tên hiển thị do người tải đặt
  fileName   String // tên file gốc, giữ phần mở rộng khi tải về
  mimeType   String
  size       Int
  data       Bytes
  uploaderId String?
  uploader   User?       @relation("DocumentFileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([setId, createdAt])
  @@index([uploaderId])
}

// Tài liệu dạng đường dẫn (Google Drive, Docs...) trong một bộ hồ sơ
model DocumentLink {
  id        String      @id @default(cuid())
  setId     String
  set       DocumentSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  title     String
  url       String
  creatorId String?
  creator   User?       @relation("DocumentLinkCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([setId, createdAt])
}

// Đơn xin nghỉ phép: quản lý trực tiếp duyệt; chưa có quản lý thì quản lý nghỉ phép duyệt
model LeaveRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  type         String // "ANNUAL" | "UNPAID"
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  halfDay      String? // "AM" | "PM" — chỉ khi nghỉ một ngày
  days         Float // số ngày làm việc được tính (0,5 nếu nghỉ nửa ngày)
  reason       String?
  status       String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "CANCELLED"
  deciderId    String?
  decider      User?     @relation("LeaveDecider", fields: [deciderId], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())

  @@index([userId, startDate])
  @@index([status, startDate])
}

// Điều chỉnh số ngày đã dùng theo năm; đơn đã duyệt vẫn được tính tự động.
model LeaveUsageAdjustment {
  userId         String
  year           Int
  adjustmentDays Float    @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, year])
}

// Phòng họp dùng chung của công ty. Phòng ngừng dùng (isActive = false) không đặt mới được
// nhưng các cuộc họp đã đặt vẫn giữ nguyên.
model MeetingRoom {
  id        String    @id @default(cuid())
  name      String    @unique
  capacity  Int? // sức chứa, chỉ để tham khảo khi chọn phòng
  isActive  Boolean   @default(true)
  meetings  Meeting[]
  createdAt DateTime  @default(now())
}

// Cuộc họp nội bộ. Huỷ họp chỉ đổi status chứ không xoá dòng, nên phòng được trả lại
// ngay (kiểm tra trùng phòng chỉ xét các cuộc họp SCHEDULED) mà vẫn giữ lịch sử.
model Meeting {
  id            String            @id @default(cuid())
  title         String
  description   String?
  startAt       DateTime
  endAt         DateTime
  status        String            @default("SCHEDULED") // "SCHEDULED" | "CANCELLED"
  sequence      Int               @default(0) // tăng mỗi lần sửa/huỷ để lịch trong email cập nhật đúng bản mới nhất
  meetingUrl    String? // link họp online (Meet, Zoom...) do người đặt tự dán
  roomId        String?
  room          MeetingRoom?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  organizerId   String
  organizer     User              @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  attendees     MeetingAttendee[]
  notifications Notification[]
  cancelledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, startAt])
  @@index([roomId, status, startAt])
  @@index([organizerId, startAt])
}

model MeetingAttendee {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  response  String   @default("PENDING") // "PENDING" | "ACCEPTED" | "DECLINED"
  createdAt DateTime @default(now())

  @@unique([meetingId, userId])
  @@index([userId])
}

  client   Client  @relation("ClientFieldChanges", fields: [clientId], references: [id], onDelete: Cascade)
  actorId  String?
  actor    User?   @relation("ClientFieldChangeActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
}

// crm53: người và thời điểm cập nhật từng mục sổ tay; giá trị nằm trên Client, thay đổi ghi ClientFieldChange.
model ClientPlaybookUpdate {
  id          String   @id @default(cuid())
  section     String // PROCUREMENT | PAYMENT | BRAND | EXECUTION
  updatedAt   DateTime @updatedAt

  clientId    String
  client      Client  @relation("ClientPlaybookUpdates", fields: [clientId], references: [id], onDelete: Cascade)
  updatedById String?
  updatedBy   User?   @relation("ClientPlaybookUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([clientId, section])
}

// crm53: đánh giá của khách sau dự án; không lưu tên hay thông tin cá nhân người đánh giá phía khách.
model ProjectFeedback {
  id          String   @id @default(cuid())
  rating      Int // 1-5
  note        String?
  caseStudy   String   @default("NOT_ASKED") // ALLOWED | NOT_ASKED | DENIED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId   String  @unique
  project     Project @relation("ProjectFeedback", fields: [projectId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?   @relation("ProjectFeedbackAuthor", fields: [createdById], references: [id], onDelete: SetNull)
}

// crm52: mẫu chiến dịch chăm sóc do Admin quản lý; bước chỉ ghi việc, không lưu giá trị quà (G-LEGAL).
model CareCampaignTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  steps       Json
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// crm52: chiến dịch chăm sóc một nhóm khách. steps/options/filter là bản chụp lúc lưu; chỉ tạo việc cho người làm, không gửi email.
model CareCampaign {
  id                  String    @id @default(cuid())
  name                String
  goal                String?
  targetOpportunities Int?
  status              String    @default("DRAFT") // DRAFT | ACTIVE | PAUSED | DONE | CANCELLED
  startDate           DateTime
  endDate             DateTime?
  steps               Json
  options             Json
  filter              Json
  assignments         Json      @default("{}")
  launchedAt          DateTime?
  pausedAt            DateTime?
  closedAt            DateTime?
  version             Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  teamId      String?
  team        SalesTeam?           @relation("CareCampaignTeam", fields: [teamId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?                @relation("CareCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  targets     CareCampaignTarget[] @relation("CareCampaignTargets")

  @@index([status])
  @@index([teamId])
}

model CareCampaignTarget {
  id            String    @id @default(cuid())
  status        String    @default("ACTIVE") // ACTIVE | STOPPED | DONE
  stoppedReason String?
  stoppedAt     DateTime?
  createdAt     DateTime  @default(now())

  campaignId   String
  campaign     CareCampaign       @relation("CareCampaignTargets", fields: [campaignId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client             @relation("CareCampaignTargetClient", fields: [clientId], references: [id], onDelete: Restrict)
  picAccountId String?
  picAccount   Account?           @relation("CareCampaignTargetPic", fields: [picAccountId], references: [id], onDelete: SetNull)
  tasks        CareCampaignTask[] @relation("CareCampaignTargetTasks")

  @@unique([campaignId, clientId])
  @@index([clientId, status])
}

model CareCampaignTask {
  id        String   @id @default(cuid())
  stepIndex Int
  createdAt DateTime @default(now())

  targetId     String
  target       CareCampaignTarget @relation("CareCampaignTargetTasks", fields: [targetId], references: [id], onDelete: Cascade)
  taskId       String             @unique
  task         Task               @relation("CareCampaignTaskTask", fields: [taskId], references: [id], onDelete: Cascade)
  touchpointId String?
  touchpoint   Touchpoint?        @relation("CareCampaignTaskTouchpoint", fields: [touchpointId], references: [id], onDelete: SetNull)

  @@unique([targetId, stepIndex])
  @@index([touchpointId])
}

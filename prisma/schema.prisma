generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                 String                         @id @default(cuid())
  email                              String                         @unique
  googleSub                          String?                        @unique
  googleMeetToken                    String?
  googleToken                        String?
  googleEmail                        String?
  googleScopes                       String[]                       @default([])
  createdChatSpaces                  Project[]                      @relation("ProjectChatSpaceCreator")
  name                               String
  avatarUrl                          String?
  passwordHash                       String
  signaturePinHash                   String?
  sessionVersion                     Int                            @default(0)
  role                               String                         @default("USER") // "ADMIN" | "ACCOUNT" | "ACCOUNTANT" | "USER"
  isActive                           Boolean                        @default(true)
  deactivatedAt                      DateTime?
  deletedAt                          DateTime?
  managerId                          String? // người quản lý trực tiếp
  manager                            User?                          @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports                            User[]                         @relation("TeamManager") // nhân viên dưới quyền
  createdAt                          DateTime                       @default(now())
  memberships                        ProjectMember[]
  ownedProjects                      Project[]                      @relation("ProjectOwner")
  assignedTasks                      Task[]                         @relation("TaskAssignee")
  createdTasks                       Task[]                         @relation("TaskCreator")
  comments                           Comment[]
  notifications                      Notification[]
  pushSubscriptions                  PushSubscription[]
  taskFollows                        TaskFollower[]
  accountProfile                     Account?
  groupMemberships                   MemberGroupMember[]
  uploadedFiles                      ProjectFile[]                  @relation("ProjectFileUploader")
  uploadedTaskFiles                  TaskFile[]                     @relation("TaskFileUploader")
  recognitionsSent                   Recognition[]                  @relation("RecognitionSender")
  recognitionsReceived               Recognition[]                  @relation("RecognitionRecipient")
  recognitionComments                RecognitionComment[]
  workflowRoleGrants                 WorkflowRoleGrant[]            @relation("WorkflowRoleGrantUser")
  grantedWorkflowRoles               WorkflowRoleGrant[]            @relation("WorkflowRoleGrantAdmin")
  workflowReaders                    WorkflowRequestReader[]
  workflowEvents                     WorkflowApprovalEvent[]        @relation("WorkflowApprovalEventActor")
  workflowDeliveries                 WorkflowNotificationDelivery[]
  workflowSignatureAsset             WorkflowSignatureAsset?        @relation("WorkflowSignatureAssetOwner")
  workflowSignatureAssetAudits       WorkflowSignatureAssetAudit[]  @relation("WorkflowSignatureAssetAuditOwner")
  workflowSignatureAssetActions      WorkflowSignatureAssetAudit[]  @relation("WorkflowSignatureAssetAuditActor")
  workflowSigningEvents              WorkflowSigningEvent[]         @relation("WorkflowSigningEventActor")
  paymentDiscussions                 PaymentLineDiscussion[]
  actualCostLinesCreated             ActualCostLine[]               @relation("ActualCostLineCreator")
  actualCostVersionsCreated          ActualCostVersion[]            @relation("ActualCostVersionCreator")
  actualCostApprovalsActed           ActualCostApproval[]           @relation("ActualCostApprovalActor")
  actualCostSheetRevisionsSubmitted  ActualCostSheetRevision[]      @relation("ActualCostSheetRevisionSubmitter")
  actualCostSheetRevisionsDecided    ActualCostSheetRevision[]      @relation("ActualCostSheetRevisionDecider")
  actualCostSheetEventsActed         ActualCostSheetEvent[]         @relation("ActualCostSheetEventActor")
  actualCostAllocationsCreated       ActualCostFundingAllocation[]  @relation("ActualCostFundingAllocationCreator")
  customerLiquidationsCreated        CustomerLiquidation[]          @relation("CustomerLiquidationCreator")
  customerCashInsCreated             CustomerCashIn[]               @relation("CustomerCashInCreator")
  customerAcceptanceSnapshotsCreated CustomerAcceptanceSnapshot[]   @relation("CustomerAcceptanceSnapshotCreator")
  customerAcceptanceExportsCreated   CustomerAcceptanceExport[]     @relation("CustomerAcceptanceExportCreator")
  settlementDossiersCreated          ProjectSettlementDossier[]     @relation("SettlementDossierCreator")
  settlementVersionsCreated          ProjectSettlementVersion[]     @relation("SettlementVersionCreator")
  settlementReplacementsActed        ProjectSettlementVersion[]     @relation("SettlementReplacementActor")
  settlementEvidenceAdded            SettlementEvidence[]           @relation("SettlementEvidenceActor")
  financialCloseRequestsCreated      FinancialCloseRequest[]        @relation("FinancialCloseRequester")
  financialCloseEventsActed          FinancialCloseEvent[]          @relation("FinancialCloseEventActor")
  settlementExportsCreated           SettlementExportAudit[]        @relation("SettlementExportActor")
  settlementCorrectionsRequested     SettlementCorrectionAttempt[]  @relation("SettlementCorrectionRequester")
  supplierVersionsCreated            SupplierVersion[]              @relation("SupplierVersionCreator")
  supplierBankVersionsCreated        SupplierBankAccountVersion[]   @relation("SupplierBankVersionCreator")
  supplierEvidenceCreated            SupplierEvidence[]             @relation("SupplierEvidenceCreator")
  supplierVerificationsActed         SupplierVerification[]         @relation("SupplierVerificationActor")
  excelIntakePreviewSessions         ExcelIntakePreviewSession[]    @relation("ExcelIntakePreviewActor")
  excelIntakeOperationReceipts       ExcelIntakeOperationReceipt[]  @relation("ExcelIntakeReceiptActor")
  excelIntakeSourceEvidence          ExcelIntakeSourceEvidence[]    @relation("ExcelIntakeEvidenceActor")
  excelIntakePreviewAuthorities      ExcelIntakePreviewAuthority[]  @relation("ExcelIntakeAuthorityActor")
  organizedMeetings                  Meeting[]                      @relation("MeetingOrganizer")
  recordedMeetings                   Meeting[]                      @relation("MeetingRecorder")
  meetingInvites                     MeetingAttendee[]
  createdMeetingRecaps               MeetingRecap[]                 @relation("MeetingRecapCreator")
  recapActionItems                   MeetingRecapActionItem[]       @relation("MeetingRecapActionOwner")
  kpiPlanChanges                     KpiPlanChange[]
  uploadedDocuments                  DocumentFile[]                 @relation("DocumentFileUploader")
  createdDocumentLinks               DocumentLink[]                 @relation("DocumentLinkCreator")
  annualLeaveDays                    Float                          @default(12) // số ngày phép năm do Admin đặt
  // Ngày sinh (chỉ dùng ngày/tháng để báo sinh nhật trên trang chủ); null = chưa khai.
  birthday                           DateTime?                       @db.Date
  // Phụ trách nhân sự: xem và sửa Hồ sơ nhân sự của mọi người (Admin luôn có quyền).
  isHrManager                        Boolean                         @default(false)
  employeeRecord                     EmployeeRecord?                 @relation("EmployeeRecordOwner")
  updatedEmployeeRecords             EmployeeRecord[]                @relation("EmployeeRecordUpdater")
  // Quản lý nghỉ phép: duyệt đơn của người chưa có quản lý, nhận thông báo kết quả mọi đơn
  isLeaveManager                     Boolean                        @default(false)
  leaveRequests                      LeaveRequest[]                 @relation("LeaveRequester")
  leaveDecisions                     LeaveRequest[]                 @relation("LeaveDecider")
  leaveAdjustments                   LeaveUsageAdjustment[]
  icApprovals                        Project[]                      @relation("ProjectIcApprover")
  acApprovals                        Project[]                      @relation("ProjectAcApprover")
  createdSuppliers                   FinanceSupplier[]              @relation("SupplierCreator")
  updatedSuppliers                   FinanceSupplier[]              @relation("SupplierUpdater")
  createdFinanceSheets               FinanceSheet[]                 @relation("FinanceSheetCreator")
  updatedFinanceSheets               FinanceSheet[]                 @relation("FinanceSheetUpdater")
  submittedFinanceSheets             FinanceSheet[]                 @relation("FinanceSheetSubmitter")
  approvedFinanceSheets              FinanceSheet[]                 @relation("FinanceSheetApprover")
  financeApprovalEvents              FinanceApprovalEvent[]
  aiSourceRevisionsCreated           AiSourceRevision[]             @relation("AiSourceRevisionCreator")
  aiRuns                             AiRun[]                        @relation("AiRunActor")
  aiCandidateReviews                 AiCandidateField[]             @relation("AiCandidateReviewer")
  aiFindingAssignments               AiFinding[]                    @relation("AiFindingOwner")
  aiFindingResolutions               AiFinding[]                    @relation("AiFindingResolver")
  aiReviewEvents                     AiReviewEvent[]                @relation("AiReviewEventActor")
  aiApplicationReceipts              AiApplicationReceipt[]        @relation("AiApplicationReceiptActor")
  aiKnowledgePublications            AiKnowledgePublication[]      @relation("AiKnowledgePublisher")
  aiMappingAdapters                  AiMappingAdapter[]             @relation("AiMappingConfirmer")
  documentIntakeDraftsCreated        DocumentIntakeDraft[]          @relation("DocumentIntakeDraftCreator")
  extensionTokens                    ExtensionToken[]
  creativeArticlesReviewed           CreativeArticle[]               @relation("CreativeArticleReviewer")
  articleReads                       ArticleReader[]

  @@index([isActive])
}

// Mỗi trình duyệt/thiết bị đăng ký riêng; endpoint chỉ thuộc một tài khoản.
model PushSubscription {
  id             String    @id @default(cuid())
  endpoint       String    @unique
  p256dh         String
  auth           String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionVersion Int
  lastTestAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

enum ProjectCategory {
  CLIENT
  INTERNAL
}

model Project {
  id                            String                               @id @default(cuid())
  name                          String
  description                   String?
  category                      ProjectCategory                      @default(CLIENT)
  purchaseOrderNumber           String?                              @unique
  color                         String                               @default("#6366f1")
  status                        String                               @default("BIDDING") // "BIDDING" | "ON_PROCESS" | "PENDING" | "DONE" | "CANCEL" | "FAIL"
  type                          String                               @default("OTHER") // "TEAMBUILDING" | "MICE" | "ACTIVATION" | "EVENT" | "PUR" | "OTHER"
  executionStartAt              DateTime? // ngày bắt đầu thực hiện (chạy event)
  executionEndAt                DateTime? // ngày kết thúc — null nếu chỉ 1 ngày
  revenue                       Float                                @default(0) // doanh thu dự kiến/thực tế (VND)
  googleChatSpaceName           String?
  googleChatSpaceUri            String?
  googleChatSpaceById           String?
  googleChatSpaceBy             User?                                @relation("ProjectChatSpaceCreator", fields: [googleChatSpaceById], references: [id], onDelete: SetNull)
  ownerId                       String
  owner                         User                                 @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  clientId                      String?
  client                        Client?                              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  accountId                     String?
  account                       Account?                             @relation(fields: [accountId], references: [id], onDelete: SetNull)
  responsibleTeamId             String?
  responsibleTeam               SalesTeam?                           @relation(fields: [responsibleTeamId], references: [id], onDelete: SetNull)
  responsibleGroupId            String?
  responsibleGroup              MemberGroup?                         @relation(fields: [responsibleGroupId], references: [id], onDelete: SetNull)
  icApproverId                  String?
  icApprover                    User?                                @relation("ProjectIcApprover", fields: [icApproverId], references: [id], onDelete: SetNull)
  acApproverId                  String?
  acApprover                    User?                                @relation("ProjectAcApprover", fields: [acApproverId], references: [id], onDelete: SetNull)
  members                       ProjectMember[]
  tasks                         Task[]
  files                         ProjectFile[]
  meetings                      Meeting[]
  financeSheets                 FinanceSheet[]
  onProcessAt                   DateTime? // thời điểm đầu tiên chuyển sang ON_PROCESS - dùng ghi nhận doanh thu
  completedAt                   DateTime? // thời điểm chuyển sang DONE
  createdAt                     DateTime                             @default(now())
  costFlow                      CostFlowWorkspace?
  workflowRequests              WorkflowRequest[]
  costFlowCash                  CostFlowCash[]
  costFlowEvidence              CostFlowEvidence[]
  costFlowHistory               CostFlowHistory[]
  paymentRequestLines           PaymentRequestLine[]
  paymentRecipients             PaymentRecipientSnapshot[]
  cashAllocations               CostFlowCashAllocation[]
  paymentDiscussions            PaymentLineDiscussion[]
  advanceApplications           AdvanceApplication[]
  actualCostLines               ActualCostLine[]
  actualCostVersions            ActualCostVersion[]
  actualCostApprovals           ActualCostApproval[]
  actualCostEvidenceLinks       ActualCostEvidenceLink[]
  actualCostApplications        ActualCostApplication[]
  actualCostSheet               ActualCostSheet?
  actualCostSheetRevisions      ActualCostSheetRevision[]
  actualCostSheetEvents         ActualCostSheetEvent[]
  actualCostFundingAllocations  ActualCostFundingAllocation[]
  customerLiquidations          CustomerLiquidation[]
  customerCashIns               CustomerCashIn[]
  customerAcceptanceSnapshots   CustomerAcceptanceSnapshot[]
  settlementDossier             ProjectSettlementDossier?
  settlementVersions            ProjectSettlementVersion[]
  settlementObligations         SettlementRecipientObligation[]
  settlementCashAllocations     SettlementCashAllocation[]
  settlementLocks               SettlementLock[]
  settlementEvidence            SettlementEvidence[]
  financialCloseRequests        FinancialCloseRequest[]
  settlementExports             SettlementExportAudit[]
  settlementCorrectionAttempts  SettlementCorrectionAttempt[]
  settlementAdvanceManifestRows SettlementAdvanceManifestRow[]
  settlementCorrectionPairs     SettlementCorrectionObligationPair[]
  settlementExportProjections   SettlementExportSourceProjection[]
  legacySupplierAliases         LegacySupplierAlias[]
  excelIntakePreviewSessions    ExcelIntakePreviewSession[]
  excelIntakeOperationReceipts  ExcelIntakeOperationReceipt[]
  excelIntakeSourceEvidence     ExcelIntakeSourceEvidence[]
  excelIntakePreviewAuthorities ExcelIntakePreviewAuthority[]
  aiSourceRevisions              AiSourceRevision[]
  aiRuns                         AiRun[]
  aiFindings                     AiFinding[]
  aiMappingAdapters              AiMappingAdapter[]
  documentIntakeDrafts            DocumentIntakeDraft[]

  @@index([status, onProcessAt])
  @@index([status, completedAt])
  @@index([executionStartAt])
  @@index([responsibleTeamId])
  @@index([responsibleGroupId])
  @@index([icApproverId])
  @@index([googleChatSpaceById])
  @@index([acApproverId])
}

// Danh bạ nhà cung cấp dùng chung cho IC, AC và phiếu đề nghị chi.
// Mọi người xem được, kể cả thông tin chuyển khoản.
model FinanceSupplier {
  id            String     @id @default(cuid())
  name          String // tên đầy đủ, vd "CÔNG TY TNHH IN ẤN TÂN HOÀNG VIỆT"
  shortName     String? // tên gọi trong cột SUP của IC/AC, vd "TÂN HOÀNG VIỆT", "HUY"
  // Khoá chữ thường của name/shortName (supplierKey) để database tự chặn trùng
  // không phân biệt hoa thường, kể cả khi hai người lưu cùng lúc.
  nameKey       String     @unique
  shortNameKey  String?    @unique
  kind          String     @default("COMPANY") // "COMPANY" | "PERSON"
  taxCode       String?
  phone         String?
  email         String?
  bankAccount   String?
  bankName      String?
  accountHolder String?
  note          String?
  createdById   String?
  createdBy     User?      @relation("SupplierCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById   String?
  updatedBy     User?      @relation("SupplierUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  icCostLines   CostLine[] @relation("CostLineIcSupplier")
  acCostLines   CostLine[] @relation("CostLineAcSupplier")

  @@index([createdById])
  @@index([updatedById])
}

// Bảng tài chính của dự án, giống một file IC/AC: khối Báo giá, Nghiệm thu, IC, AC
// nằm trên cùng các dòng. Mỗi phiên bản là một bảng; bản đang dùng có superseded = false.
model FinanceSheet {
  id               String                 @id @default(cuid())
  projectId        String
  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version          Int                    @default(1)
  icStatus         String                 @default("DRAFT") // "DRAFT" | "SUBMITTED" | "APPROVED" | "REJECTED"
  acStatus         String                 @default("NONE") // "NONE" | "DRAFT" | "SUBMITTED" | "APPROVED" | "REJECTED"
  superseded       Boolean                @default(false)
  // Thông tin chung — mục trống tự ẩn khi xuất file
  clientName       String?
  programName      String?
  headcount        String? // ghi tự do, vd "240 khách"
  location         String?
  eventStart       DateTime?
  eventEnd         DateTime?
  sellVatRate      Decimal                @default(0.08) @db.Decimal(5, 4)
  // Tổng lưu sẵn để hiển thị nhanh (luôn tính lại bằng code khi lưu)
  sellSubtotal     Decimal                @default(0) @db.Decimal(18, 0)
  icCostSubtotal   Decimal                @default(0) @db.Decimal(18, 0)
  createdById      String?
  createdBy        User?                  @relation("FinanceSheetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById      String?
  updatedBy        User?                  @relation("FinanceSheetUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  // Duyệt IC
  icSubmittedAt    DateTime?
  icSubmittedById  String?
  icSubmittedBy    User?                  @relation("FinanceSheetSubmitter", fields: [icSubmittedById], references: [id], onDelete: SetNull)
  icApprovedAt     DateTime?
  icApprovedById   String?
  icApprovedBy     User?                  @relation("FinanceSheetApprover", fields: [icApprovedById], references: [id], onDelete: SetNull)
  icRejectReason   String?
  // Người được CC trong email duyệt; lần gửi sau của dự án gợi ý lại danh sách này.
  icCcUserIds      String[]               @default([])
  // Message-ID của email gửi duyệt, để email kết quả nằm cùng luồng thư.
  icEmailMessageId String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  sections         FinanceSection[]
  approvalEvents   FinanceApprovalEvent[]

  @@unique([projectId, version])
  @@index([createdById])
  @@index([updatedById])
  @@index([icSubmittedById])
  @@index([icApprovedById])
}

// Lịch sử duyệt của bảng tài chính: ai gửi, ai duyệt/từ chối, lúc nào, lý do gì.
model FinanceApprovalEvent {
  id           String       @id @default(cuid())
  sheetId      String
  sheet        FinanceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  stage        String       @default("IC") // "IC" | "AC"
  action       String // "SUBMIT" | "WITHDRAW" | "APPROVE" | "REJECT" | "NEW_VERSION"
  actorId      String?
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  note         String? // lời nhắn khi gửi, lý do khi từ chối
  selfApproval Boolean      @default(false) // người duyệt cũng là người gửi (Q16)
  createdAt    DateTime     @default(now())

  @@index([sheetId, createdAt])
  @@index([actorId])
}

model FinanceSection {
  id        String       @id @default(cuid())
  sheetId   String
  sheet     FinanceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  order     Int
  name      String // "I. SẢN XUẤT"
  sellLines SellLine[]

  @@index([sheetId, order])
}

// Một hạng mục bán (khối Báo giá + Nghiệm thu); có thể có nhiều dòng chi phí.
model SellLine {
  id                String         @id @default(cuid())
  sectionId         String
  section           FinanceSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order             Int
  stt               String? // số thứ tự ghi trên file, vd "1", "2a"
  name              String
  description       String?
  unit              String?
  quantity          Decimal?       @db.Decimal(14, 3)
  unitPrice         Decimal?       @db.Decimal(18, 2) // null = "-" (không tính tiền riêng)
  note              String?
  acceptedQuantity  Decimal?       @db.Decimal(14, 3) // Nghiệm thu
  acceptedUnitPrice Decimal?       @db.Decimal(18, 2)
  acceptedNote      String?
  costs             CostLine[]

  @@index([sectionId, order])
}

// Một dòng chi phí (khối IC + AC).
model CostLine {
  id           String           @id @default(cuid())
  sellLineId   String
  sellLine     SellLine         @relation(fields: [sellLineId], references: [id], onDelete: Cascade)
  order        Int
  description  String?
  unit         String?
  icQuantity   Decimal?         @db.Decimal(14, 3)
  icUnitPrice  Decimal?         @db.Decimal(18, 2)
  icVatRate    Decimal?         @db.Decimal(5, 4) // null = không có VAT đầu vào
  icSupplierId String?
  icSupplier   FinanceSupplier? @relation("CostLineIcSupplier", fields: [icSupplierId], references: [id], onDelete: Restrict)
  icNote       String?
  acQuantity   Decimal?         @db.Decimal(14, 3)
  acUnitPrice  Decimal?         @db.Decimal(18, 2)
  acVatRate    Decimal?         @db.Decimal(5, 4)
  acSupplierId String?
  acSupplier   FinanceSupplier? @relation("CostLineAcSupplier", fields: [acSupplierId], references: [id], onDelete: Restrict)
  acNote       String?
  addedInAc    Boolean          @default(false) // dòng phát sinh, không có trong IC

  @@index([sellLineId, order])
  @@index([icSupplierId])
  @@index([acSupplierId])
}

// Danh mục khách hàng — do admin tạo sẵn
model Client {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  projects  Project[]
}

// Danh mục account (đầu mối phụ trách) — do admin tạo sẵn
model Account {
  id         String             @id @default(cuid())
  name       String
  userId     String?            @unique
  user       User?              @relation(fields: [userId], references: [id], onDelete: Restrict)
  teamId     String
  team       SalesTeam          @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdAt  DateTime           @default(now())
  projects   Project[]
  ledTeam    SalesTeam?         @relation("SalesTeamLeader")
  kpiTargets KpiAccountTarget[]

  @@index([teamId])
}

// Team kinh doanh — dùng nhóm các Account để theo dõi hiệu suất
model SalesTeam {
  id         String          @id @default(cuid())
  name       String          @unique
  createdAt  DateTime        @default(now())
  accounts   Account[]
  projects   Project[]
  // Trưởng team: Account được quyền chia KPI team xuống từng Account
  leaderId   String?         @unique
  leader     Account?        @relation("SalesTeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  kpiTargets KpiTeamTarget[]
}

// Kế hoạch KPI doanh số theo năm. Chỉ tiêu tháng của công ty = tổng chỉ tiêu các team.
model KpiPlan {
  id             String             @id @default(cuid())
  year           Int                @unique
  companyTarget  Float              @default(0) // KPI doanh số cả năm của công ty (VND)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  // Đã chốt: không ai sửa được chỉ tiêu cho tới khi Admin mở lại
  lockedAt       DateTime?
  changes        KpiPlanChange[]
  teamTargets    KpiTeamTarget[]
  accountTargets KpiAccountTarget[]
}

// Nhật ký thay đổi kế hoạch KPI: ai lưu, chốt hay mở lại, lúc nào
model KpiPlanChange {
  id        String   @id @default(cuid())
  planId    String
  plan      KpiPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String // giữ tên tại thời điểm thay đổi, kể cả khi user bị xoá
  summary   String
  createdAt DateTime @default(now())

  @@index([planId, createdAt])
}

// Admin giao KPI cho team theo tháng
model KpiTeamTarget {
  id     String    @id @default(cuid())
  planId String
  plan   KpiPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  teamId String
  team   SalesTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  month  Int // 1-12
  amount Float     @default(0)

  @@unique([planId, teamId, month])
  @@index([teamId])
}

// Trưởng team chia KPI team xuống từng Account theo tháng
model KpiAccountTarget {
  id        String  @id @default(cuid())
  planId    String
  plan      KpiPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  month     Int // 1-12
  amount    Float   @default(0)

  @@unique([planId, accountId, month])
  @@index([accountId])
}

// Phòng ban / nhóm phụ trách dự án và thêm nhiều thành viên trong một lần
model MemberGroup {
  id        String              @id @default(cuid())
  name      String              @unique
  createdAt DateTime            @default(now())
  members   MemberGroupMember[]
  projects  Project[]
}

model MemberGroupMember {
  id        String      @id @default(cuid())
  groupId   String
  userId    String
  group     MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member") // "owner" | "member"
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model ProjectFile {
  id                 String    @id @default(cuid())
  projectId          String
  uploaderId         String?
  name               String
  mimeType           String
  size               Int
  // Nội dung file khi chưa chuyển lên Google Drive; null khi file đã nằm trên Drive.
  data               Bytes?
  driveFileId        String? // file trên Shared Drive của công ty
  driveSyncStartedAt DateTime? // đang đẩy lên Drive (chống đẩy trùng)
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader           User?     @relation("ProjectFileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())

  @@index([projectId, createdAt])
  @@index([uploaderId])
}

model Task {
  id              String                  @id @default(cuid())
  title           String
  description     String?
  result          String? // kết quả/bàn giao sau khi hoàn thành công việc
  status          String                  @default("TODO") // "TODO" | "IN_PROGRESS" | "DONE"
  priority        String                  @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"
  startDate       DateTime? // thời gian bắt đầu dự kiến; cùng ngày và trước dueDate
  dueDate         DateTime?
  completedAt     DateTime? // thời điểm chuyển sang DONE — dùng tính đúng hạn/trễ hạn
  order           Float                   @default(0)
  projectId       String
  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId      String?
  assignee        User?                   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId       String
  creator         User                    @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  comments        Comment[]
  followers       TaskFollower[]
  notifications   Notification[]
  files           TaskFile[]
  recapActionItem MeetingRecapActionItem? // việc cần làm trong biên bản họp đã tạo ra task này
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

// Tệp đính kèm của task — BRIEF khi giao việc, RESULT khi bàn giao kết quả
model TaskFile {
  id                 String    @id @default(cuid())
  taskId             String
  uploaderId         String?
  kind               String // "BRIEF" | "RESULT"
  name               String
  mimeType           String
  size               Int
  // Nội dung file khi chưa chuyển lên Google Drive; null khi file đã nằm trên Drive.
  data               Bytes?
  driveFileId        String?
  driveSyncStartedAt DateTime?
  task               Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader           User?     @relation("TaskFileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())

  @@index([taskId, createdAt])
  @@index([uploaderId])
}

// Người theo dõi task — nhận thông báo khi task có bình luận hoặc thay đổi quan trọng
model TaskFollower {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
}

model Notification {
  id                String           @id @default(cuid())
  dedupeKey         String?          @unique // chống tạo trùng cho thông báo tự động
  userId            String // người nhận
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String // task, comment, workflow, meeting, leave, recognition, or reminder notification
  message           String
  taskId            String?
  task              Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId         String? // để dẫn link tới board
  recognitionId     String?
  recognition       Recognition?     @relation("RecognitionNotification", fields: [recognitionId], references: [id], onDelete: SetNull)
  workflowRequestId String?
  workflowRequest   WorkflowRequest? @relation(fields: [workflowRequestId], references: [id], onDelete: SetNull)
  meetingId         String? // để dẫn link tới lịch họp
  meeting           Meeting?         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  read              Boolean          @default(false)
  createdAt         DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([recognitionId])
  @@index([workflowRequestId])
  @@index([meetingId])
}

// Lời cảm ơn độc lập với project — dùng để mọi người ghi nhận nhau trong công việc và cuộc sống.
model Recognition {
  id            String               @id @default(cuid())
  senderId      String
  recipientId   String
  message       String
  category      String               @default("KINDNESS") // KINDNESS | SUPPORT | INSPIRATION | CARE | BIRTHDAY
  visibility    String               @default("COMPANY") // COMPANY | PRIVATE
  sender        User                 @relation("RecognitionSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient     User                 @relation("RecognitionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  notifications Notification[]       @relation("RecognitionNotification")
  comments      RecognitionComment[]
  createdAt     DateTime             @default(now())

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@index([visibility, createdAt])
}

// Bình luận dưới một lời cảm ơn trên Kudos Wall.
model RecognitionComment {
  id            String      @id @default(cuid())
  recognitionId String
  recognition   Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime    @default(now())

  @@index([recognitionId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  mentions  Json     @default("[]")
  body      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Bộ đếm đăng nhập sai, lưu theo khóa HMAC của email/IP để không lưu thêm PII.
// Dùng database thay vì bộ nhớ tiến trình để rate limit hoạt động trên nhiều instance.
model LoginRateLimit {
  key             String    @id
  failures        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}

// Shared Workflow foundation; finance consumes this rather than owning approval states.
model WorkflowRequest {
  id                          String                              @id @default(cuid())
  projectId                   String?
  project                     Project?                            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  templateId                  String?
  template                    WorkflowTemplate?                   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  module                      String
  kind                        String
  title                       String
  creatorId                   String
  cashAssigneeId              String
  parentId                    String?
  state                       String                              @default("DRAFT")
  steps                       Json
  currentStep                 Int                                 @default(0)
  version                     Int                                 @default(0)
  currentAttemptId            String?
  currentStepArrivedAt        DateTime?
  replacesRequestId           String?
  replacedByRequestId         String?
  pendingReplacementRequestId String?
  supersededAt                DateTime?
  payload                     Json
  createdAt                   DateTime                            @default(now())
  updatedAt                   DateTime                            @updatedAt
  decisions                   WorkflowDecision[]
  cash                        CostFlowCash[]
  evidence                    CostFlowEvidence[]
  files                       WorkflowFile[]
  history                     WorkflowHistory[]
  approvalEvents              WorkflowApprovalEvent[]
  readers                     WorkflowRequestReader[]
  notifications               Notification[]
  paymentLines                PaymentRequestLine[]
  paymentRecipients           PaymentRecipientSnapshot[]
  cashAllocations             CostFlowCashAllocation[]
  paymentDiscussions          PaymentLineDiscussion[]
  advanceApplications         AdvanceApplication[]                @relation("AdvanceApplicationRequest")
  actualCostApplications      ActualCostApplication[]             @relation("ActualCostApplicationRequest")
  actualCostSheetRevision     ActualCostSheetRevision?            @relation("ActualCostSheetRevisionRequest")
  settlementVersions          ProjectSettlementVersion[]
  approvedSnapshots           WorkflowApprovedSnapshot[]
  signingLifecycle            WorkflowSigningLifecycle?
  signingCommands             WorkflowSigningCommand[]
  workflowSigningEvents       WorkflowSigningEvent[]
  physicalScanBatches         WorkflowPhysicalScanBatch[]
  physicalSigningTransitions  WorkflowPhysicalSigningTransition[]

  @@index([projectId, module, createdAt])
  @@index([creatorId, state])
  @@index([cashAssigneeId])
  @@index([state, currentStepArrivedAt])
  @@index([replacesRequestId])
  @@index([replacedByRequestId])
  @@index([pendingReplacementRequestId])
}

// Reusable signature images are high-value owner-only assets. They are kept
// outside User so ordinary identity/session projections cannot disclose bytes.
model WorkflowSignatureAsset {
  id         String                        @id @default(cuid())
  ownerId    String                        @unique
  owner      User                          @relation("WorkflowSignatureAssetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  pngData    Bytes
  mimeType   String                        @default("image/png")
  sha256     String
  byteLength Int
  width      Int
  height     Int
  createdAt  DateTime                      @default(now())
  updatedAt  DateTime                      @updatedAt
  audits     WorkflowSignatureAssetAudit[]

  @@index([sha256])
}

// Append-only metadata audit. Signature bytes and PIN values are never copied
// into audit rows.
model WorkflowSignatureAssetAudit {
  id         String                  @id @default(cuid())
  assetId    String?
  asset      WorkflowSignatureAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  ownerId    String
  owner      User                    @relation("WorkflowSignatureAssetAuditOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  actorId    String
  actor      User                    @relation("WorkflowSignatureAssetAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  sha256     String?
  byteLength Int?
  width      Int?
  height     Int?
  createdAt  DateTime                @default(now())

  @@index([ownerId, createdAt])
  @@index([actorId, createdAt])
}

model WorkflowApprovedSnapshot {
  id                 String                                 @id @default(cuid())
  requestId          String
  request            WorkflowRequest                        @relation(fields: [requestId], references: [id], onDelete: Restrict)
  version            Int
  mode               String
  evidenceState      String
  projection         Json
  projectionSha256   String
  attestationKeyId   String
  attestation        String
  createdAt          DateTime                               @default(now())
  signingEvents      WorkflowSigningEvent[]
  lifecycles         WorkflowSigningLifecycle[]
  publicCapabilities WorkflowPublicVerificationCapability[]
  settlementExports  SettlementExportAudit[]
  settlementVersions ProjectSettlementVersion[]             @relation("SettlementVersionApprovedSnapshot")

  @@unique([requestId, version])
  @@unique([id, requestId])
  @@index([projectionSha256])
  @@index([attestationKeyId])
}

model WorkflowPublicVerificationCapability {
  id                   String                   @id @default(cuid())
  snapshotId           String
  snapshot             WorkflowApprovedSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  exportAuditId        String?                  @unique
  exportAudit          SettlementExportAudit?   @relation(fields: [exportAuditId], references: [id], onDelete: Restrict)
  publicNonce          String                   @unique
  tokenDigest          String                   @unique
  attestationKeyId     String
  issuedAt             DateTime                 @default(now())
  revokedAt            DateTime?
  replacedAt           DateTime?
  replacedBySnapshotId String?

  @@index([revokedAt, replacedAt])
  @@index([attestationKeyId])
  @@index([snapshotId])
}

model WorkflowPublicVerificationRateLimit {
  key             String    @id
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}

model WorkflowSigningEvent {
  id                   String                    @id @default(cuid())
  snapshotId           String?
  snapshot             WorkflowApprovedSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  requestId            String
  request              WorkflowRequest           @relation(fields: [requestId], references: [id], onDelete: Restrict)
  version              Int
  role                 String
  actorId              String
  actor                User                      @relation("WorkflowSigningEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  signaturePngData     Bytes
  signatureImageSha256 String
  legalCommitment      Boolean                   @default(true)
  previousEventHash    String?
  eventHash            String
  pinVerified          Boolean                   @default(true)
  signerIpNormalized   String?
  signerIpSource       String                    @default("UNAVAILABLE")
  signedAt             DateTime                  @default(now())

  @@unique([requestId, version, role])
  @@index([snapshotId, role])
  @@index([requestId, version, signedAt])
  @@index([actorId, signedAt])
  @@index([eventHash])
}

model WorkflowSigningLifecycle {
  id              String                    @id @default(cuid())
  requestId       String                    @unique
  request         WorkflowRequest           @relation(fields: [requestId], references: [id], onDelete: Restrict)
  snapshotId      String?
  snapshot        WorkflowApprovedSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  mode            String
  evidenceState   String
  expectedVersion Int
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([snapshotId])
  @@index([mode, evidenceState])
}

model WorkflowPhysicalScanBatch {
  id                 String                              @id @default(cuid())
  requestId          String
  request            WorkflowRequest                     @relation(fields: [requestId], references: [id], onDelete: Restrict)
  version            Int
  status             String                              @default("PENDING")
  keeperDeclared     String
  locationDeclared   String
  keeperNormalized   String?
  locationNormalized String?
  uploadedById       String
  returnedReason     String?
  confirmedById      String?
  confirmedAt        DateTime?
  supersededAt       DateTime?
  createdAt          DateTime                            @default(now())
  files              WorkflowPhysicalScanFile[]
  transitions        WorkflowPhysicalSigningTransition[]

  @@unique([requestId, version])
  @@index([requestId, status, createdAt])
}

model WorkflowPhysicalScanFile {
  id        String                    @id @default(cuid())
  batchId   String
  batch     WorkflowPhysicalScanBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  name      String
  mimeType  String
  size      Int
  data      Bytes
  sha256    String
  createdAt DateTime                  @default(now())

  @@index([batchId, createdAt])
  @@index([sha256])
}

model WorkflowPhysicalSigningTransition {
  id        String                    @id @default(cuid())
  requestId String
  request   WorkflowRequest           @relation(fields: [requestId], references: [id], onDelete: Restrict)
  batchId   String
  batch     WorkflowPhysicalScanBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  actorId   String
  action    String
  reason    String                    @default("")
  details   Json?
  createdAt DateTime                  @default(now())

  @@index([requestId, createdAt])
  @@index([batchId, createdAt])
}

model WorkflowSigningCommand {
  id          String          @id @default(cuid())
  requestId   String
  request     WorkflowRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  commandKey  String
  fingerprint String
  result      Json?
  createdAt   DateTime        @default(now())

  @@unique([requestId, commandKey])
  @@index([requestId, fingerprint])
}

model WorkflowApprovalEvent {
  id               String                         @id @default(cuid())
  requestId        String
  request          WorkflowRequest                @relation(fields: [requestId], references: [id], onDelete: Restrict)
  module           String
  attemptId        String?
  submittedVersion Int?
  mutationVersion  Int
  stepIndex        Int
  role             String
  actorId          String
  actor            User                           @relation("WorkflowApprovalEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  action           String
  reason           String                         @default("")
  details          Json?
  fromAssigneeId   String?
  toAssigneeId     String?
  createdAt        DateTime                       @default(now())
  deliveries       WorkflowNotificationDelivery[]

  @@unique([requestId, mutationVersion, action])
  @@index([actorId, createdAt])
  @@index([requestId, attemptId, createdAt])
}

model WorkflowRoleGrant {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("WorkflowRoleGrantUser", fields: [userId], references: [id], onDelete: Restrict)
  role        String
  grantedById String
  grantedBy   User      @relation("WorkflowRoleGrantAdmin", fields: [grantedById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([userId, role, revokedAt])
}

model WorkflowRequestReader {
  id        String          @id @default(cuid())
  requestId String
  request   WorkflowRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  reason    String
  createdAt DateTime        @default(now())

  @@unique([requestId, userId])
  @@index([userId, createdAt])
}

model WorkflowNotificationDelivery {
  id            String                @id @default(cuid())
  eventId       String
  event         WorkflowApprovalEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  status        String                @default("PENDING")
  attempts      Int                   @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([eventId, userId])
  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
}

model WorkflowTemplate {
  id                        String            @id @default(cuid())
  familyId                  String
  category                  String            @default("")
  purpose                   String            @default("")
  changeNote                String            @default("")
  requirements              Json?
  kind                      String
  name                      String
  version                   Int
  parentId                  String?
  ownerId                   String
  accountantId              String
  ceoId                     String
  signerNames               String
  instructions              String
  requiresExecutionTracking Boolean           @default(false)
  fileId                    String?
  ownerConfirmedAt          DateTime?
  publishedAt               DateTime?
  revision                  Int               @default(0)
  createdBy                 String
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  requests                  WorkflowRequest[]
  files                     WorkflowFile[]

  @@unique([familyId, version])
  @@index([ownerId, publishedAt])
}

// Append-only bytes: exactly one template/request parent is enforced by the service.
model WorkflowFile {
  id             String            @id @default(cuid())
  templateId     String?
  template       WorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  requestId      String?
  request        WorkflowRequest?  @relation(fields: [requestId], references: [id], onDelete: Restrict)
  kind           String
  supportingSlot String?
  name           String
  mimeType       String
  size           Int
  data           Bytes
  sha256         String
  uploadedBy     String
  createdAt      DateTime          @default(now())

  @@index([requestId, createdAt])
  @@index([templateId])
}

model WorkflowHistory {
  id        String          @id @default(cuid())
  requestId String
  request   WorkflowRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  version   Int
  actorId   String
  action    String
  snapshot  Json
  createdAt DateTime        @default(now())

  @@unique([requestId, version])
}

model WorkflowDecision {
  id        String          @id @default(cuid())
  requestId String
  request   WorkflowRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  version   Int
  step      Int
  actorId   String
  action    String
  reason    String
  createdAt DateTime        @default(now())

  @@unique([requestId, version])
}

model CostFlowWorkspace {
  projectId String   @id
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  version   Int      @default(0)
  data      Json
  updatedAt DateTime @updatedAt
}

// Server-owned, resumable Excel preview authority. Payloads and temporary
// bytes are nullable so expiry/cancel/supersession can retain only audit data.
model ExcelIntakePreviewSession {
  id                   String                       @id @default(cuid())
  projectId            String
  project              Project                      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actorId              String
  actor                User                         @relation("ExcelIntakePreviewActor", fields: [actorId], references: [id], onDelete: Restrict)
  operationKind        String
  scopeKey             String
  draftId              String?
  sourceKind           String
  sourceRevision       Int
  sourceSha256         String
  sourceFilename       String?
  sourceMimeType       String?
  sourceSize           Int
  sourceBytes          Bytes?
  canonicalFingerprint String
  canonicalPayload     Json?
  displayPayload       Json?
  status               String                       @default("ACTIVE")
  expiresAt            DateTime
  supersededAt         DateTime?
  cancelledAt          DateTime?
  consumedAt           DateTime?
  receiptId            String?                      @unique
  receipt              ExcelIntakeOperationReceipt? @relation("ExcelIntakeSessionReceipt", fields: [receiptId], references: [id], onDelete: Restrict)
  resultKind           String?
  resultId             String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  operationReceipt     ExcelIntakeOperationReceipt? @relation("ExcelIntakeReceiptSession")
  sourceEvidence       ExcelIntakeSourceEvidence?   @relation("ExcelIntakeEvidenceSession")

  @@index([projectId, actorId, operationKind, scopeKey, status])
  @@index([expiresAt, status])
  @@index([draftId])
  @@index([sourceSha256])
}

// Monotonic scope epoch reserved before expensive parsing. Only the request
// holding the current generation may publish an actionable preview session.
model ExcelIntakePreviewAuthority {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actorId       String
  actor         User     @relation("ExcelIntakeAuthorityActor", fields: [actorId], references: [id], onDelete: Restrict)
  operationKind String
  scopeKey      String
  generation    Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([projectId, actorId, operationKind, scopeKey])
  @@index([actorId, updatedAt])
}

// Durable replay record. No TTL/count eviction exists; lifecycle follows the
// linked business draft/revision retained in the CostFlow workspace.
model ExcelIntakeOperationReceipt {
  id                   String                     @id @default(cuid())
  projectId            String
  project              Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  previewSessionId     String                     @unique
  previewSession       ExcelIntakePreviewSession  @relation("ExcelIntakeReceiptSession", fields: [previewSessionId], references: [id], onDelete: Restrict)
  consumedSession      ExcelIntakePreviewSession? @relation("ExcelIntakeSessionReceipt")
  idempotencyKey       String
  actorId              String
  actor                User                       @relation("ExcelIntakeReceiptActor", fields: [actorId], references: [id], onDelete: Restrict)
  operationKind        String
  canonicalFingerprint String
  result               Json
  linkedRecordKind     String
  linkedRecordId       String
  createdAt            DateTime                   @default(now())
  sourceEvidence       ExcelIntakeSourceEvidence?

  @@unique([projectId, idempotencyKey])
  @@index([projectId, linkedRecordKind, linkedRecordId])
  @@index([actorId, createdAt])
}

// Immutable successful XLSX source evidence, separate from expiring preview
// payloads and directly linked to the receipt and resulting business record.
model ExcelIntakeSourceEvidence {
  id               String                      @id @default(cuid())
  projectId        String
  project          Project                     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  previewSessionId String                      @unique
  previewSession   ExcelIntakePreviewSession   @relation("ExcelIntakeEvidenceSession", fields: [previewSessionId], references: [id], onDelete: Restrict)
  receiptId        String                      @unique
  receipt          ExcelIntakeOperationReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  actorId          String
  actor            User                        @relation("ExcelIntakeEvidenceActor", fields: [actorId], references: [id], onDelete: Restrict)
  operationKind    String
  filename         String
  mimeType         String?
  size             Int
  sha256           String
  data             Bytes
  linkedRecordKind String
  linkedRecordId   String
  createdAt        DateTime                    @default(now())

  @@index([projectId, linkedRecordKind, linkedRecordId])
  @@index([sha256])
  @@index([actorId, createdAt])
}

// Company-wide supplier identity. Legal and bank details live in immutable
// version rows so submitted payment snapshots never drift with later edits.
model Supplier {
  id             String                 @id @default(cuid())
  status         String                 @default("ACTIVE")
  currentVersion Int                    @default(1)
  taxCodeKey     String?                @unique
  dedupeKey      String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  archivedAt     DateTime?
  versions       SupplierVersion[]
  bankAccounts   SupplierBankAccount[]
  evidence       SupplierEvidence[]
  verifications  SupplierVerification[]
  legacyAliases  LegacySupplierAlias[]

  @@index([status, dedupeKey])
}

model SupplierVersion {
  id                String                 @id @default(cuid())
  supplierId        String
  supplier          Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  version           Int
  legalName         String
  normalizedName    String
  taxCode           String?
  normalizedTaxCode String?
  address           String                 @default("")
  contactName       String                 @default("")
  contactEmail      String                 @default("")
  contactPhone      String                 @default("")
  changeReason      String                 @default("")
  createdById       String
  createdBy         User                   @relation("SupplierVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime               @default(now())
  verifications     SupplierVerification[]
  legacyAliases     LegacySupplierAlias[]

  @@unique([supplierId, version])
  @@unique([id, supplierId])
  @@index([normalizedName])
  @@index([normalizedTaxCode])
  @@index([createdById, createdAt])
}

model SupplierBankAccount {
  id             String                       @id @default(cuid())
  supplierId     String
  supplier       Supplier                     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status         String                       @default("ACTIVE")
  isPrimary      Boolean                      @default(false)
  currentVersion Int                          @default(1)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  archivedAt     DateTime?
  versions       SupplierBankAccountVersion[]
  verifications  SupplierVerification[]
  legacyAliases  LegacySupplierAlias[]

  @@unique([id, supplierId])
  @@index([supplierId, status])
}

model SupplierBankAccountVersion {
  id                 String                 @id @default(cuid())
  supplierId         String
  bankAccountId      String
  bankAccount        SupplierBankAccount    @relation(fields: [bankAccountId, supplierId], references: [id, supplierId], onDelete: Restrict)
  version            Int
  bankName           String
  bankCode           String                 @default("")
  accountHolder      String
  accountNumber      String
  accountLast4       String
  accountFingerprint String
  changeReason       String                 @default("")
  createdById        String
  createdBy          User                   @relation("SupplierBankVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime               @default(now())
  verifications      SupplierVerification[]
  legacyAliases      LegacySupplierAlias[]

  @@unique([bankAccountId, version])
  @@unique([id, bankAccountId, supplierId])
  @@index([supplierId, accountFingerprint])
  @@index([createdById, createdAt])
}

model SupplierEvidence {
  id            String                 @id @default(cuid())
  supplierId    String
  supplier      Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  kind          String                 @default("BANK_ACCOUNT_PROOF")
  name          String
  mimeType      String
  byteLength    Int
  data          Bytes
  sha256        String
  createdById   String
  createdBy     User                   @relation("SupplierEvidenceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime               @default(now())
  verifications SupplierVerification[]

  @@index([supplierId, createdAt])
  @@index([sha256])
}

model SupplierVerification {
  id                   String                     @id @default(cuid())
  supplierId           String
  supplier             Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierVersionId    String
  supplierVersion      SupplierVersion            @relation(fields: [supplierVersionId, supplierId], references: [id, supplierId], onDelete: Restrict)
  bankAccountId        String
  bankAccount          SupplierBankAccount        @relation(fields: [bankAccountId, supplierId], references: [id, supplierId], onDelete: Restrict)
  bankAccountVersionId String
  bankAccountVersion   SupplierBankAccountVersion @relation(fields: [bankAccountVersionId, bankAccountId, supplierId], references: [id, bankAccountId, supplierId], onDelete: Restrict)
  decision             String
  reason               String                     @default("")
  evidenceId           String?
  evidence             SupplierEvidence?          @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  actorId              String
  actor                User                       @relation("SupplierVerificationActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt            DateTime                   @default(now())

  @@index([supplierId, supplierVersionId, bankAccountVersionId, createdAt])
  @@index([actorId, createdAt])
  @@index([evidenceId])
}

// One payable identity per real electronic VAT invoice. XML/PDF are formats
// on the same root, while AC allocations and payment applications retain the
// exact immutable approval lineage.
model VendorInvoice {
  id                   String                     @id @default(cuid())
  projectId            String
  supplierId           String
  supplierVersionId    String
  bankAccountId        String
  bankAccountVersionId String
  businessKey          String                     @unique
  invoiceNumber        String
  symbol               String
  issuedAt             DateTime
  sellerTaxCode        String
  netAmount            String
  vatAmount            String
  grossAmount          String
  state                String                     @default("DRAFT")
  sourceSnapshot       Json
  createdById          String
  createdAt            DateTime                   @default(now())
  submittedAt          DateTime?
  files                VendorInvoiceFile[]
  actualCosts          VendorInvoiceActualCost[]
  applications         VendorInvoiceApplication[]

  @@index([projectId, state, createdAt])
  @@index([supplierId, supplierVersionId, bankAccountVersionId])
}

model VendorInvoiceFile {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      VendorInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  format       String
  name         String
  mimeType     String
  byteLength   Int
  data         Bytes
  sha256       String
  metadataHash String
  createdById  String
  createdAt    DateTime      @default(now())

  @@unique([invoiceId, format])
  @@index([sha256])
}

model VendorInvoiceActualCost {
  id                  String                     @id @default(cuid())
  invoiceId           String
  invoice             VendorInvoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  projectId           String
  actualCostLineId    String
  actualCostVersionId String
  approvalId          String
  approvalAttemptId   String
  stableLineId        String
  icRevisionId        String?
  icLineId            String?
  recipientKey        String
  approvedAmount      String
  allocatedAmount     String
  sourceSnapshot      Json
  createdAt           DateTime                   @default(now())
  applications        VendorInvoiceApplication[]

  @@unique([invoiceId, actualCostVersionId, approvalId])
  @@index([projectId, actualCostVersionId, approvalId])
  @@index([icRevisionId, icLineId])
}

model VendorInvoiceApplication {
  id                  String                  @id @default(cuid())
  invoiceId           String
  invoice             VendorInvoice           @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  invoiceActualCostId String
  invoiceActualCost   VendorInvoiceActualCost @relation(fields: [invoiceActualCostId], references: [id], onDelete: Restrict)
  projectId           String
  requestId           String
  paymentLineId       String?
  amount              String
  state               String                  @default("ACTIVE")
  idempotencyKey      String                  @unique
  sourceSnapshot      Json
  createdAt           DateTime                @default(now())
  releasedAt          DateTime?

  @@unique([requestId, invoiceActualCostId])
  @@index([projectId, requestId, state])
  @@index([invoiceId, state])
}

model LegacySupplierAlias {
  id                   String                     @id @default(cuid())
  projectId            String
  project              Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  legacyBeneficiaryId  String
  legacyRecipientKey   String
  supplierId           String
  supplier             Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierVersionId    String
  supplierVersion      SupplierVersion            @relation(fields: [supplierVersionId, supplierId], references: [id, supplierId], onDelete: Restrict)
  bankAccountId        String
  bankAccount          SupplierBankAccount        @relation(fields: [bankAccountId, supplierId], references: [id, supplierId], onDelete: Restrict)
  bankAccountVersionId String
  bankAccountVersion   SupplierBankAccountVersion @relation(fields: [bankAccountVersionId, bankAccountId, supplierId], references: [id, bankAccountId, supplierId], onDelete: Restrict)
  sourceProofId        String?
  sourceSnapshot       Json
  createdAt            DateTime                   @default(now())

  @@unique([projectId, legacyBeneficiaryId])
  @@unique([projectId, legacyRecipientKey])
  @@index([supplierId, projectId])
  @@index([bankAccountId])
}

// Standalone, immutable customer-safe quotation snapshots. Replacing content means
// publishing another template; archived templates stay available for administration.
model QuotationTemplate {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  snapshot    Json
  status      String    @default("ACTIVE") // "ACTIVE" | "ARCHIVED"
  proposalId  String?   @unique
  createdBy   String
  createdAt   DateTime  @default(now())
  archivedAt  DateTime?

  @@index([status, createdAt])
}

// Account proposals freeze the exact finalized quotation projection reviewed by Admin.
model QuotationTemplateProposal {
  id                String    @id @default(cuid())
  sourceProjectId   String
  sourceQuotationId String
  proposedName      String
  note              String    @default("")
  snapshot          Json
  status            String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  proposedBy        String
  reviewedBy        String?
  reviewedAt        DateTime?
  rejectionReason   String?
  templateId        String?   @unique
  createdAt         DateTime  @default(now())

  @@index([status, createdAt])
  @@index([sourceProjectId, sourceQuotationId])
}

model CostFlowCash {
  id                    String                     @id @default(cuid())
  projectId             String
  project               Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requestId             String
  request               WorkflowRequest            @relation(fields: [requestId], references: [id], onDelete: Restrict)
  recipientKey          String
  direction             String
  channel               String                     @default("LEGACY")
  amount                String // actual source decimal, never IEEE Float or auto-rounded receipt
  reference             String
  idempotencyKey        String                     @default(uuid())
  commandFingerprint    String                     @default("LEGACY")
  allocations           Json
  evidenceId            String
  occurredAt            DateTime
  confirmedBy           String
  createdAt             DateTime                   @default(now())
  normalizedAllocations CostFlowCashAllocation[]
  settlementAllocations SettlementCashAllocation[]

  @@unique([projectId, idempotencyKey])
  @@unique([projectId, reference])
  @@unique([id, projectId, recipientKey])
  @@index([projectId, recipientKey])
  @@index([projectId, requestId, recipientKey, direction])
}

model PaymentRequestLine {
  id                  String                   @id @default(cuid())
  projectId           String
  project             Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requestId           String
  request             WorkflowRequest          @relation(fields: [requestId], references: [id], onDelete: Restrict)
  stableKey           String
  position            Int
  description         String
  amount              String
  icRevisionId        String
  icLineId            String
  sourceSnapshot      Json
  recipientKey        String
  recipient           PaymentRecipientSnapshot @relation(fields: [requestId, recipientKey], references: [requestId, recipientKey], onDelete: Restrict)
  evidenceManifest    Json
  createdAt           DateTime                 @default(now())
  cashAllocations     CostFlowCashAllocation[]
  discussions         PaymentLineDiscussion[]
  advanceApplications AdvanceApplication[]

  @@unique([requestId, stableKey])
  @@index([projectId, requestId])
  @@index([icRevisionId, icLineId])
  @@index([requestId, recipientKey])
}

model PaymentRecipientSnapshot {
  id            String               @id @default(cuid())
  projectId     String
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requestId     String
  request       WorkflowRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  recipientKey  String
  recipientType String
  displayName   String
  bankName      String?
  accountLast4  String?
  sourceVersion Int?
  totalAmount   String
  createdAt     DateTime             @default(now())
  lines         PaymentRequestLine[]

  @@unique([requestId, recipientKey])
  @@index([projectId, requestId])
}

model CostFlowCashAllocation {
  id                            String                         @id @default(cuid())
  projectId                     String
  project                       Project                        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  cashId                        String
  cash                          CostFlowCash                   @relation(fields: [cashId], references: [id], onDelete: Restrict)
  requestId                     String
  request                       WorkflowRequest                @relation(fields: [requestId], references: [id], onDelete: Restrict)
  requestLineId                 String
  requestLine                   PaymentRequestLine             @relation(fields: [requestLineId], references: [id], onDelete: Restrict)
  recipientKey                  String
  direction                     String
  amount                        String
  createdAt                     DateTime                       @default(now())
  settlementLocks               SettlementLock[]
  settlementAdvanceManifestRows SettlementAdvanceManifestRow[]

  @@unique([cashId, requestLineId])
  @@unique([id, projectId, recipientKey])
  @@index([projectId, requestId, recipientKey, direction])
  @@index([requestLineId, direction])
}

model PaymentLineDiscussion {
  id        String             @id @default(cuid())
  projectId String
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requestId String
  request   WorkflowRequest    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  lineId    String
  line      PaymentRequestLine @relation(fields: [lineId], references: [id], onDelete: Restrict)
  authorId  String
  author    User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String
  createdAt DateTime           @default(now())

  @@index([requestId, lineId, createdAt])
  @@index([authorId, createdAt])
}

model AdvanceApplication {
  id                            String                         @id @default(cuid())
  projectId                     String
  project                       Project                        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  advanceRequestId              String
  advanceRequest                WorkflowRequest                @relation("AdvanceApplicationRequest", fields: [advanceRequestId], references: [id], onDelete: Restrict)
  advanceLineId                 String
  advanceLine                   PaymentRequestLine             @relation(fields: [advanceLineId], references: [id], onDelete: Restrict)
  expenseId                     String
  recipientKey                  String
  amount                        String
  createdBy                     String
  createdAt                     DateTime                       @default(now())
  settlementLocks               SettlementLock[]
  settlementAdvanceManifestRows SettlementAdvanceManifestRow[]

  @@unique([advanceLineId, expenseId])
  @@unique([id, projectId, recipientKey])
  @@index([projectId, recipientKey])
  @@index([advanceRequestId, createdAt])
  @@index([expenseId])
}

// Copies evidence bytes at use time; deleting a project upload cannot change a submitted dossier.
model CostFlowEvidence {
  id                   String                   @id @default(cuid())
  projectId            String
  project              Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requestId            String?
  request              WorkflowRequest?         @relation(fields: [requestId], references: [id], onDelete: Restrict)
  sourceFileId         String
  kind                 String
  name                 String
  mimeType             String
  data                 Bytes
  sha256               String
  createdBy            String
  createdAt            DateTime                 @default(now())
  actualCostLinks      ActualCostEvidenceLink[]
  customerLiquidations CustomerLiquidation[]
  customerCashIns      CustomerCashIn[]
  settlementEvidence   SettlementEvidence[]

  @@index([projectId, requestId])
}

// Normalized actual-cost authority. Legacy CostFlowWorkspace.expenses remains readable,
// but only these immutable versions and DD decisions can produce approved AC.
model ActualCostLine {
  id               String                        @id @default(cuid())
  projectId        String
  project          Project                       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  stableLineId     String
  sourceKind       String                        @default("IC_LINKED")
  icRevisionId     String?
  icLineId         String?
  recipientKey     String
  createdById      String
  createdBy        User                          @relation("ActualCostLineCreator", fields: [createdById], references: [id], onDelete: Restrict)
  currentVersion   Int                           @default(0)
  draftRemovedAt   DateTime?
  draftRemovedById String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  versions         ActualCostVersion[]
  approvals        ActualCostApproval[]
  applications     ActualCostApplication[]
  revisionLines    ActualCostSheetRevisionLine[]
  sheetEvents      ActualCostSheetEvent[]

  @@unique([projectId, stableLineId])
  @@index([projectId, icRevisionId, icLineId])
  @@index([projectId, recipientKey])
}

model ActualCostVersion {
  id                 String                        @id @default(cuid())
  projectId          String
  project            Project                       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  lineId             String
  line               ActualCostLine                @relation(fields: [lineId], references: [id], onDelete: Restrict)
  version            Int
  state              String                        @default("SUBMITTED")
  description        String
  fundingSource      String
  quantity           String
  days               String
  unitPrice          String
  unit               String                        @default("")
  basis              String                        @default("GROSS")
  vatPercent         String                        @default("0")
  amount             String
  rawAmount          String
  sourceSnapshot     Json?
  billable           Boolean                       @default(false)
  saleSnapshot       Json?
  createdById        String
  createdBy          User                          @relation("ActualCostVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submittedAt        DateTime?
  createdAt          DateTime                      @default(now())
  approvals          ActualCostApproval[]
  evidenceLinks      ActualCostEvidenceLink[]
  applications       ActualCostApplication[]
  revisionLines      ActualCostSheetRevisionLine[]
  fundingAllocations ActualCostFundingAllocation[]
  sheetEvents        ActualCostSheetEvent[]

  @@unique([lineId, version])
  @@index([projectId, state, createdAt])
  @@index([projectId, fundingSource])
}

// One canonical Actual Cost sheet per Project. Individual line versions remain
// reusable draft facts; only an immutable sheet revision manifest can be sent
// to and decided by DD.
model ActualCostSheet {
  id              String                    @id @default(cuid())
  projectId       String                    @unique
  project         Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  currentRevision Int                       @default(0)
  mutationVersion Int                       @default(0)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  revisions       ActualCostSheetRevision[]

  @@index([projectId, updatedAt])
}

model ActualCostSheetRevision {
  id                         String                        @id @default(cuid())
  sheetId                    String
  sheet                      ActualCostSheet               @relation(fields: [sheetId], references: [id], onDelete: Restrict)
  projectId                  String
  project                    Project                       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  revision                   Int
  state                      String                        @default("DRAFT")
  icRevisionId               String
  mutationVersion            Int                           @default(0)
  manifestHash               String?
  submittedById              String?
  submittedBy                User?                         @relation("ActualCostSheetRevisionSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  decidedById                String?
  decidedBy                  User?                         @relation("ActualCostSheetRevisionDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  workflowRequestId          String?                       @unique
  workflowRequest            WorkflowRequest?              @relation("ActualCostSheetRevisionRequest", fields: [workflowRequestId], references: [id], onDelete: Restrict)
  note                       String                        @default("")
  missingEvidenceExplanation String                        @default("")
  overBudgetExplanation      String                        @default("")
  decisionReason             String                        @default("")
  submittedAt                DateTime?
  decidedAt                  DateTime?
  returnedAt                 DateTime?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  lines                      ActualCostSheetRevisionLine[]
  events                     ActualCostSheetEvent[]

  @@unique([sheetId, revision])
  @@index([projectId, state, createdAt])
  @@index([submittedById, submittedAt])
  @@index([decidedById, decidedAt])
}

model ActualCostSheetRevisionLine {
  id         String                  @id @default(cuid())
  projectId  String
  revisionId String
  revision   ActualCostSheetRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  lineId     String
  line       ActualCostLine          @relation(fields: [lineId], references: [id], onDelete: Restrict)
  versionId  String
  version    ActualCostVersion       @relation(fields: [versionId], references: [id], onDelete: Restrict)
  position   Int
  createdAt  DateTime                @default(now())

  @@unique([revisionId, lineId])
  @@unique([revisionId, versionId])
  @@index([projectId, revisionId, position])
  @@index([lineId, versionId])
}

model ActualCostFundingAllocation {
  id           String            @id @default(cuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versionId    String
  version      ActualCostVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  source       String
  amount       String
  recipientKey String            @default("")
  position     Int               @default(0)
  createdById  String
  createdBy    User              @relation("ActualCostFundingAllocationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())

  @@unique([versionId, position])
  @@index([projectId, source])
  @@index([recipientKey])
}

model ActualCostSheetEvent {
  id         String                  @id @default(cuid())
  projectId  String
  project    Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  revisionId String
  revision   ActualCostSheetRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  lineId     String?
  line       ActualCostLine?         @relation(fields: [lineId], references: [id], onDelete: Restrict)
  versionId  String?
  version    ActualCostVersion?      @relation(fields: [versionId], references: [id], onDelete: Restrict)
  action     String
  actorId    String
  actor      User                    @relation("ActualCostSheetEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  payload    Json                    @default("{}")
  createdAt  DateTime                @default(now())

  @@index([projectId, revisionId, createdAt])
  @@index([lineId, createdAt])
  @@index([actorId, createdAt])
}

model ActualCostApproval {
  id           String                  @id @default(cuid())
  projectId    String
  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  lineId       String
  line         ActualCostLine          @relation(fields: [lineId], references: [id], onDelete: Restrict)
  versionId    String
  version      ActualCostVersion       @relation(fields: [versionId], references: [id], onDelete: Restrict)
  attemptId    String
  retryKey     String
  action       String
  actorId      String
  actor        User                    @relation("ActualCostApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)
  reason       String                  @default("")
  warningCodes Json                    @default("[]")
  createdAt    DateTime                @default(now())
  applications ActualCostApplication[]

  @@unique([versionId])
  @@unique([projectId, retryKey])
  @@index([projectId, action, createdAt])
  @@index([actorId, createdAt])
}

model ActualCostEvidenceLink {
  id         String            @id @default(cuid())
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  versionId  String
  version    ActualCostVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  evidenceId String
  evidence   CostFlowEvidence  @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  kind       String
  actorId    String
  createdAt  DateTime          @default(now())

  @@unique([versionId, evidenceId, kind])
  @@index([projectId, versionId])
  @@index([evidenceId])
}

model ActualCostApplication {
  id              String             @id @default(cuid())
  projectId       String
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  lineId          String
  line            ActualCostLine     @relation(fields: [lineId], references: [id], onDelete: Restrict)
  versionId       String
  version         ActualCostVersion  @relation(fields: [versionId], references: [id], onDelete: Restrict)
  approvalId      String
  approval        ActualCostApproval @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  requestId       String
  request         WorkflowRequest    @relation("ActualCostApplicationRequest", fields: [requestId], references: [id], onDelete: Restrict)
  recipientKey    String
  amount          String
  state           String             @default("ACTIVE")
  createdById     String
  createdAt       DateTime           @default(now())
  releasedAt      DateTime?
  settlementLocks SettlementLock[]

  @@unique([versionId, requestId])
  @@unique([id, projectId, recipientKey])
  @@index([projectId, recipientKey, state])
  @@index([requestId, state])
}

model CustomerLiquidation {
  id             String           @id @default(cuid())
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  version        Int
  documentNumber String
  signedAt       DateTime
  netAmount      String
  vatAmount      String
  grossAmount    String
  evidenceId     String
  evidence       CostFlowEvidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  sourceSnapshot Json
  createdById    String
  createdBy      User             @relation("CustomerLiquidationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime         @default(now())
  cashIns        CustomerCashIn[]

  @@unique([projectId, version])
  @@index([projectId, signedAt])
}

model CustomerCashIn {

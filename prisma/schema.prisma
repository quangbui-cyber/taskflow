  occurredAt         DateTime
  amount             String
  reference          String
  evidenceId         String?
  evidence           CostFlowEvidence?    @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  idempotencyKey     String
  commandFingerprint String
  createdById        String
  createdBy          User                 @relation("CustomerCashInCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime             @default(now())

  @@unique([projectId, idempotencyKey])
  @@unique([projectId, reference])
  @@index([projectId, occurredAt])
}

model CustomerAcceptanceSnapshot {
  id                           String                     @id @default(cuid())
  projectId                    String
  project                      Project                    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  version                      Int
  quotationId                  String
  liquidationId                String?
  projection                   Json
  selectedActualCostVersionIds Json                       @default("[]")
  createdById                  String
  createdBy                    User                       @relation("CustomerAcceptanceSnapshotCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt                    DateTime                   @default(now())
  exports                      CustomerAcceptanceExport[]

  @@unique([projectId, version])
  @@index([projectId, quotationId])
}

model CustomerAcceptanceExport {
  id             String                     @id @default(cuid())
  snapshotId     String
  snapshot       CustomerAcceptanceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  format         String
  projectionHash String

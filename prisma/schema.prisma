generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  googleSub                String?                  @unique
  googleMeetToken          String? // refresh token Google (đã mã hoá) để tạo link Meet; null = chưa kết nối
  googleToken              String? // refresh token Google Workspace (đã mã hoá): gửi email, tạo nhóm Chat; null = chưa kết nối
  googleEmail              String? // tài khoản Google đã kết nối (trùng email đăng nhập)
  googleScopes             String[]                 @default([]) // quyền người dùng đã cho phép
  createdChatSpaces        Project[]                @relation("ProjectChatSpaceCreator")
  name                     String
  avatarUrl                String?
  passwordHash             String
  sessionVersion           Int                      @default(0)
  role                     String                   @default("USER") // "ADMIN" | "ACCOUNT" | "ACCOUNTANT" | "USER"
  isActive                 Boolean                  @default(true)
  deactivatedAt            DateTime?
  // Xoá tài khoản chỉ đánh dấu dòng này để tên vẫn còn trên dự án đã đóng,
  // task đã xong và bình luận; tài khoản bị ẩn khỏi danh sách và không đăng nhập được.
  deletedAt                DateTime?
  managerId                String? // người quản lý trực tiếp
  manager                  User?                    @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports                  User[]                   @relation("TeamManager") // nhân viên dưới quyền
  createdAt                DateTime                 @default(now())
  memberships              ProjectMember[]
  ownedProjects            Project[]                @relation("ProjectOwner")
  assignedTasks            Task[]                   @relation("TaskAssignee")
  createdTasks             Task[]                   @relation("TaskCreator")
  comments                 Comment[]
  notifications            Notification[]
  pushSubscriptions        PushSubscription[]
  taskFollows              TaskFollower[]
  accountProfile           Account?
  groupMemberships         MemberGroupMember[]
  uploadedFiles            ProjectFile[]            @relation("ProjectFileUploader")
  uploadedTaskFiles        TaskFile[]               @relation("TaskFileUploader")
  recognitionsSent         Recognition[]            @relation("RecognitionSender")
  recognitionsReceived     Recognition[]            @relation("RecognitionRecipient")
  recognitionComments      RecognitionComment[]
  projectWishes            ProjectWish[]
  organizedMeetings        Meeting[]                @relation("MeetingOrganizer")
  recordedMeetings         Meeting[]                @relation("MeetingRecorder")
  meetingInvites           MeetingAttendee[]
  createdMeetingRecaps     MeetingRecap[]           @relation("MeetingRecapCreator")
  recapActionItems         MeetingRecapActionItem[] @relation("MeetingRecapActionOwner")
  recapRecipientOf         MeetingRecapRecipient[]  @relation("MeetingRecapRecipientUser")
  recapRecipientsAdded     MeetingRecapRecipient[]  @relation("MeetingRecapRecipientAdder")
  recapGlossaryTerms       RecapGlossaryTerm[]      @relation("RecapGlossaryCreator")
  kpiPlanChanges           KpiPlanChange[]
  uploadedDocuments        DocumentFile[]           @relation("DocumentFileUploader")
  createdDocumentLinks     DocumentLink[]           @relation("DocumentLinkCreator")
  annualLeaveDays          Float                    @default(12) // số ngày phép năm do Admin đặt
  // Ngày sinh (chỉ dùng ngày/tháng để báo sinh nhật trên trang chủ); null = chưa khai.
  birthday                 DateTime?                @db.Date
  // Phụ trách nhân sự: xem và sửa Hồ sơ nhân sự của mọi người (Admin luôn có quyền).
  isHrManager              Boolean                  @default(false)
  employeeRecord           EmployeeRecord?          @relation("EmployeeRecordOwner")
  updatedEmployeeRecords   EmployeeRecord[]         @relation("EmployeeRecordUpdater")
  // Quản lý nghỉ phép: duyệt đơn của người chưa có quản lý, nhận thông báo kết quả mọi đơn
  isLeaveManager           Boolean                  @default(false)
  leaveRequests            LeaveRequest[]           @relation("LeaveRequester")
  leaveDecisions           LeaveRequest[]           @relation("LeaveDecider")
  leaveAdjustments         LeaveUsageAdjustment[]
  icApprovals              Project[]                @relation("ProjectIcApprover")
  acApprovals              Project[]                @relation("ProjectAcApprover")
  createdSuppliers         Supplier[]               @relation("SupplierCreator")
  updatedSuppliers         Supplier[]               @relation("SupplierUpdater")
  extensionTokens          ExtensionToken[]
  createdFinanceSheets     FinanceSheet[]           @relation("FinanceSheetCreator")
  updatedFinanceSheets     FinanceSheet[]           @relation("FinanceSheetUpdater")
  submittedFinanceSheets   FinanceSheet[]           @relation("FinanceSheetSubmitter")
  approvedFinanceSheets    FinanceSheet[]           @relation("FinanceSheetApprover")
  financeApprovalEvents    FinanceApprovalEvent[]
  creativeArticlesReviewed CreativeArticle[]        @relation("CreativeArticleReviewer")
  articleReads             ArticleReader[]

  isCrmDataSteward       Boolean                 @default(false) // Phụ trách chất lượng dữ liệu CRM
  clientPotentialScorer  Client[]                @relation("ClientPotentialScorer")
  potentialScorer        ClientPotentialScore[]  @relation("PotentialScorer")
  crmManager             CrmTeamManager[]        @relation("CrmManager")
  opportunityCloser      Opportunity[]           @relation("OpportunityCloser")
  opportunityCreator     Opportunity[]           @relation("OpportunityCreator")
  opportunityStageActor  OpportunityStageEvent[] @relation("OpportunityStageActor")
  opportunityMemberUser  OpportunityMember[]     @relation("OpportunityMemberUser")
  expectedEventCreator   ExpectedEvent[]         @relation("ExpectedEventCreator")
  touchpointAuthor       Touchpoint[]            @relation("TouchpointAuthor")
  touchpointConfirmer    Touchpoint[]            @relation("TouchpointConfirmer")
  postponeActor          TaskPostpone[]          @relation("PostponeActor")
  crmSettingUpdater      CrmSetting[]            @relation("CrmSettingUpdater")
  crmSettingChangeUser   CrmSettingChange[]      @relation("CrmSettingChangeUser")
  trackerImportActor     TrackerImportRun[]      @relation("TrackerImportActor")
  trackerResolver        TrackerImportRow[]      @relation("TrackerResolver")
  clientMergeActor       ClientMergeLog[]        @relation("ClientMergeActor")
  clientArchiver         Client[]                @relation("ClientArchiver")
  clientFieldChangeActor ClientFieldChange[]     @relation("ClientFieldChangeActor")
  clientPlaybookUpdater  ClientPlaybookUpdate[]  @relation("ClientPlaybookUpdater")
  projectFeedbackAuthor  ProjectFeedback[]       @relation("ProjectFeedbackAuthor")
  careCampaignCreator    CareCampaign[]          @relation("CareCampaignCreator")

  @@index([isActive])
}

// Mỗi trình duyệt/thiết bị đăng ký riêng; endpoint chỉ thuộc một tài khoản.
model PushSubscription {
  id             String    @id @default(cuid())
  endpoint       String    @unique
  p256dh         String
  auth           String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionVersion Int
  lastTestAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}

enum ProjectCategory {
  CLIENT
  INTERNAL
}

model Project {
  id                  String          @id @default(cuid())
  name                String
  description         String?
  category            ProjectCategory @default(CLIENT)
  purchaseOrderNumber String?         @unique
  color               String          @default("#6366f1")
  status              String          @default("BIDDING") // "BIDDING" | "ON_PROCESS" | "PENDING" | "DONE" | "CANCEL" | "FAIL"
  type                String          @default("OTHER") // "TEAMBUILDING" | "MICE" | "ACTIVATION" | "EVENT" | "PUR" | "OTHER"
  executionStartAt    DateTime? // ngày bắt đầu thực hiện (chạy event)
  executionEndAt      DateTime? // ngày kết thúc — null nếu chỉ 1 ngày
  revenue             Float           @default(0) // doanh thu dự kiến/thực tế (VND)
  googleChatSpaceName String? // "spaces/AAAA…" — nhóm Google Chat của dự án do app tạo
  googleChatSpaceUri  String? // link mở nhóm (https://chat.google.com/room/…)
  googleChatSpaceById String?
  googleChatSpaceBy   User?           @relation("ProjectChatSpaceCreator", fields: [googleChatSpaceById], references: [id], onDelete: SetNull)
  ownerId             String
  owner               User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  clientId            String?
  client              Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  accountId           String?
  account             Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  responsibleTeamId   String?
  responsibleTeam     SalesTeam?      @relation(fields: [responsibleTeamId], references: [id], onDelete: SetNull)
  responsibleGroupId  String?
  responsibleGroup    MemberGroup?    @relation(fields: [responsibleGroupId], references: [id], onDelete: SetNull)
  // Người duyệt IC và AC đặt riêng cho từng dự án (có thể là hai người khác nhau).
  icApproverId        String?
  icApprover          User?           @relation("ProjectIcApprover", fields: [icApproverId], references: [id], onDelete: SetNull)
  acApproverId        String?
  acApprover          User?           @relation("ProjectAcApprover", fields: [acApproverId], references: [id], onDelete: SetNull)
  members             ProjectMember[]
  wishes              ProjectWish[]
  tasks               Task[]
  files               ProjectFile[]
  meetings            Meeting[]
  financeSheets       FinanceSheet[]
  onProcessAt         DateTime? // thời điểm đầu tiên chuyển sang ON_PROCESS - dùng ghi nhận doanh thu
  completedAt         DateTime? // thời điểm chuyển sang DONE
  createdAt           DateTime        @default(now())

  sourceOpportunityId String?      @unique
  sourceOpportunity   Opportunity? @relation("ProjectSourceOpportunity", fields: [sourceOpportunityId], references: [id], onDelete: SetNull)
  programType         ProgramType  @relation(fields: [type], references: [code], onDelete: Restrict, onUpdate: Cascade)
  feedback            ProjectFeedback? @relation("ProjectFeedback")

  @@index([status, onProcessAt])
  @@index([status, completedAt])
  @@index([executionStartAt])
  @@index([responsibleTeamId])
  @@index([responsibleGroupId])
  @@index([icApproverId])
  @@index([googleChatSpaceById])
  @@index([acApproverId])
}

model ProjectWish {
  id            String    @id @default(uuid())
  projectId     String
  authorId      String
  body          String
  chatSpaceName String?
  chatSentAt    DateTime?
  createdAt     DateTime  @default(now())
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([authorId])
}

// Danh bạ nhà cung cấp dùng chung cho IC, AC và phiếu đề nghị chi.
// Mọi người xem được, kể cả thông tin chuyển khoản.
model Supplier {
  id            String     @id @default(cuid())
  name          String // tên đầy đủ, vd "CÔNG TY TNHH IN ẤN TÂN HOÀNG VIỆT"
  shortName     String? // tên gọi trong cột SUP của IC/AC, vd "TÂN HOÀNG VIỆT", "HUY"
  // Khoá chữ thường của name/shortName (supplierKey) để database tự chặn trùng
  // không phân biệt hoa thường, kể cả khi hai người lưu cùng lúc.
  nameKey       String     @unique
  shortNameKey  String?    @unique
  kind          String     @default("COMPANY") // "COMPANY" | "PERSON"
  taxCode       String?
  phone         String?
  email         String?
  bankAccount   String?
  bankName      String?
  accountHolder String?
  note          String?
  createdById   String?
  createdBy     User?      @relation("SupplierCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById   String?
  updatedBy     User?      @relation("SupplierUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  icCostLines   CostLine[] @relation("CostLineIcSupplier")
  acCostLines   CostLine[] @relation("CostLineAcSupplier")

  @@index([createdById])
  @@index([updatedById])
}

// Bảng tài chính của dự án, giống một file IC/AC: khối Báo giá, Nghiệm thu, IC, AC
// nằm trên cùng các dòng. Mỗi phiên bản là một bảng; bản đang dùng có superseded = false.
model FinanceSheet {
  id               String                 @id @default(cuid())
  projectId        String
  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version          Int                    @default(1)
  icStatus         String                 @default("DRAFT") // "DRAFT" | "SUBMITTED" | "APPROVED" | "REJECTED"
  acStatus         String                 @default("NONE") // "NONE" | "DRAFT" | "SUBMITTED" | "APPROVED" | "REJECTED"
  superseded       Boolean                @default(false)
  // Thông tin chung — mục trống tự ẩn khi xuất file
  clientName       String?
  programName      String?
  headcount        String? // ghi tự do, vd "240 khách"
  location         String?
  eventStart       DateTime?
  eventEnd         DateTime?
  sellVatRate      Decimal                @default(0.08) @db.Decimal(5, 4)
  // Tổng lưu sẵn để hiển thị nhanh (luôn tính lại bằng code khi lưu)
  sellSubtotal     Decimal                @default(0) @db.Decimal(18, 0)
  icCostSubtotal   Decimal                @default(0) @db.Decimal(18, 0)
  createdById      String?
  createdBy        User?                  @relation("FinanceSheetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById      String?
  updatedBy        User?                  @relation("FinanceSheetUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  // Duyệt IC
  icSubmittedAt    DateTime?
  icSubmittedById  String?
  icSubmittedBy    User?                  @relation("FinanceSheetSubmitter", fields: [icSubmittedById], references: [id], onDelete: SetNull)
  icApprovedAt     DateTime?
  icApprovedById   String?
  icApprovedBy     User?                  @relation("FinanceSheetApprover", fields: [icApprovedById], references: [id], onDelete: SetNull)
  icRejectReason   String?
  // Người được CC trong email duyệt; lần gửi sau của dự án gợi ý lại danh sách này.
  icCcUserIds      String[]               @default([])
  // Message-ID của email gửi duyệt, để email kết quả nằm cùng luồng thư.
  icEmailMessageId String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  sections         FinanceSection[]
  approvalEvents   FinanceApprovalEvent[]

  @@unique([projectId, version])
  @@index([createdById])
  @@index([updatedById])
  @@index([icSubmittedById])
  @@index([icApprovedById])
}

// Lịch sử duyệt của bảng tài chính: ai gửi, ai duyệt/từ chối, lúc nào, lý do gì.
model FinanceApprovalEvent {
  id           String       @id @default(cuid())
  sheetId      String
  sheet        FinanceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  stage        String       @default("IC") // "IC" | "AC"
  action       String // "SUBMIT" | "WITHDRAW" | "APPROVE" | "REJECT" | "NEW_VERSION"
  actorId      String?
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  note         String? // lời nhắn khi gửi, lý do khi từ chối
  selfApproval Boolean      @default(false) // người duyệt cũng là người gửi (Q16)
  createdAt    DateTime     @default(now())

  @@index([sheetId, createdAt])
  @@index([actorId])
}

model FinanceSection {
  id        String       @id @default(cuid())
  sheetId   String
  sheet     FinanceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  order     Int
  name      String // "I. SẢN XUẤT"
  sellLines SellLine[]

  @@index([sheetId, order])
}

// Một hạng mục bán (khối Báo giá + Nghiệm thu); có thể có nhiều dòng chi phí.
model SellLine {
  id                String         @id @default(cuid())
  sectionId         String
  section           FinanceSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  order             Int
  stt               String? // số thứ tự ghi trên file, vd "1", "2a"
  name              String
  description       String?
  unit              String?
  quantity          Decimal?       @db.Decimal(14, 3)
  unitPrice         Decimal?       @db.Decimal(18, 2) // null = "-" (không tính tiền riêng)
  note              String?
  acceptedQuantity  Decimal?       @db.Decimal(14, 3) // Nghiệm thu
  acceptedUnitPrice Decimal?       @db.Decimal(18, 2)
  acceptedNote      String?
  costs             CostLine[]

  @@index([sectionId, order])
}

// Một dòng chi phí (khối IC + AC).
model CostLine {
  id           String    @id @default(cuid())
  sellLineId   String
  sellLine     SellLine  @relation(fields: [sellLineId], references: [id], onDelete: Cascade)
  order        Int
  description  String?
  unit         String?
  icQuantity   Decimal?  @db.Decimal(14, 3)
  icUnitPrice  Decimal?  @db.Decimal(18, 2)
  icVatRate    Decimal?  @db.Decimal(5, 4) // null = không có VAT đầu vào
  icSupplierId String?
  icSupplier   Supplier? @relation("CostLineIcSupplier", fields: [icSupplierId], references: [id], onDelete: Restrict)
  icNote       String?
  acQuantity   Decimal?  @db.Decimal(14, 3)
  acUnitPrice  Decimal?  @db.Decimal(18, 2)
  acVatRate    Decimal?  @db.Decimal(5, 4)
  acSupplierId String?
  acSupplier   Supplier? @relation("CostLineAcSupplier", fields: [acSupplierId], references: [id], onDelete: Restrict)
  acNote       String?
  addedInAc    Boolean   @default(false) // dòng phát sinh, không có trong IC

  @@index([sellLineId, order])
  @@index([icSupplierId])
  @@index([acSupplierId])
}

// Danh mục khách hàng — do admin tạo sẵn
model Client {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  projects  Project[]

  industry              String?
  potentialLevel        String?
  potentialScoredAt     DateTime?
  budgetSeason          String?
  budgetSeasonMonth     Int? // Tháng chốt ngân sách
  vendorSelection       String?
  valuedMost            String?
  importStatus          String?
  importConfirmedAt     DateTime?
  version               Int                    @default(0)
  picAccountId          String?
  picAccount            Account?               @relation("ClientPic", fields: [picAccountId], references: [id], onDelete: SetNull)
  responsibleTeamId     String?
  responsibleTeam       SalesTeam?             @relation("ClientTeam", fields: [responsibleTeamId], references: [id], onDelete: SetNull)
  potentialScoredById   String?
  potentialScoredBy     User?                  @relation("ClientPotentialScorer", fields: [potentialScoredById], references: [id], onDelete: SetNull)
  taskClient            Task[]                 @relation("TaskClient")
  projectFileClient     ProjectFile[]          @relation("ProjectFileClient")
  meetingClient         Meeting[]              @relation("MeetingClient")
  clientPotentialScores ClientPotentialScore[] @relation("ClientPotentialScores")
  clientBuyingUnits     BuyingUnit[]           @relation("ClientBuyingUnits")
  clientOpportunities   Opportunity[]          @relation("ClientOpportunities")
  clientExpectedEvents  ExpectedEvent[]        @relation("ClientExpectedEvents")
  clientCadences        CadenceReminder[]      @relation("ClientCadences")
  clientTouchpoints     Touchpoint[]           @relation("ClientTouchpoints")
  trackerMatchedClient  TrackerImportRow[]     @relation("TrackerMatchedClient")

  // crm50: hồ sơ công ty, mọi trường không bắt buộc.
  taxCode            String?             @unique
  legalName          String?
  shortName          String?
  website            String?
  address            String?
  parentClientId     String?
  parentClient       Client?             @relation("ClientParent", fields: [parentClientId], references: [id], onDelete: SetNull)
  childClients       Client[]            @relation("ClientParent")
  acquisitionSource  String?
  referredBy         String?
  notes              String?
  archivedAt         DateTime?
  archivedReason     String?
  archivedById       String?
  archivedBy         User?               @relation("ClientArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
  clientAliases      ClientAlias[]       @relation("ClientAliases")
  clientTagLinks     ClientTagLink[]     @relation("ClientTagLinks")
  clientCompetitors  ClientCompetitor[]  @relation("ClientCompetitors")
  clientFieldChanges ClientFieldChange[] @relation("ClientFieldChanges")

  // crm53: sổ tay làm việc, mọi trường không bắt buộc, văn bản tối đa 1000 ký tự.
  vendorStatus           String? // NOT_REGISTERED | IN_PROGRESS | REGISTERED | EXPIRED
  vendorRegisteredUntil  DateTime?
  frameworkContractUntil DateTime?
  quotesRequired         Int?
  approvalFlow           String?
  paymentTermsText       String?
  paymentPractice        String?
  invoiceNotes           String?
  brandGuidelineUrl      String?
  brandDos               String?
  brandDonts             String?
  executionNotes         String?
  clientPlaybookUpdates  ClientPlaybookUpdate[] @relation("ClientPlaybookUpdates")
  careCampaignTargets    CareCampaignTarget[]   @relation("CareCampaignTargetClient")

  @@index([parentClientId])
}

// Danh mục account (đầu mối phụ trách) — do admin tạo sẵn
model Account {
  id         String             @id @default(cuid())
  name       String
  userId     String?            @unique
  user       User?              @relation(fields: [userId], references: [id], onDelete: Restrict)
  teamId     String
  team       SalesTeam          @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdAt  DateTime           @default(now())
  projects   Project[]
  ledTeam    SalesTeam?         @relation("SalesTeamLeader")
  kpiTargets KpiAccountTarget[]

  clientPic      Client[]      @relation("ClientPic")
  opportunityPic Opportunity[] @relation("OpportunityPic")
  careCampaignPic CareCampaignTarget[] @relation("CareCampaignTargetPic")

  @@index([teamId])
}

// Team kinh doanh — dùng nhóm các Account để theo dõi hiệu suất
model SalesTeam {
  id         String          @id @default(cuid())
  name       String          @unique
  createdAt  DateTime        @default(now())
  accounts   Account[]
  projects   Project[]
  // Trưởng team: Account được quyền chia KPI team xuống từng Account
  leaderId   String?         @unique
  leader     Account?        @relation("SalesTeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  kpiTargets KpiTeamTarget[]

  clientTeam      Client[]         @relation("ClientTeam")
  crmManagedTeam  CrmTeamManager[] @relation("CrmManagedTeam")
  careCampaignTeam CareCampaign[]  @relation("CareCampaignTeam")
  opportunityTeam Opportunity[]    @relation("OpportunityTeam")
}

// Kế hoạch KPI doanh số theo năm. Chỉ tiêu tháng của công ty = tổng chỉ tiêu các team.
model KpiPlan {
  id             String             @id @default(cuid())
  year           Int                @unique
  companyTarget  Float              @default(0) // KPI doanh số cả năm của công ty (VND)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  // Đã chốt: không ai sửa được chỉ tiêu cho tới khi Admin mở lại
  lockedAt       DateTime?
  changes        KpiPlanChange[]
  teamTargets    KpiTeamTarget[]
  accountTargets KpiAccountTarget[]
}

// Nhật ký thay đổi kế hoạch KPI: ai lưu, chốt hay mở lại, lúc nào
model KpiPlanChange {
  id        String   @id @default(cuid())
  planId    String
  plan      KpiPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String // giữ tên tại thời điểm thay đổi, kể cả khi user bị xoá
  summary   String
  createdAt DateTime @default(now())

  @@index([planId, createdAt])
}

// Admin giao KPI cho team theo tháng
model KpiTeamTarget {
  id     String    @id @default(cuid())
  planId String
  plan   KpiPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  teamId String
  team   SalesTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  month  Int // 1-12
  amount Float     @default(0)

  @@unique([planId, teamId, month])
  @@index([teamId])
}

// Trưởng team chia KPI team xuống từng Account theo tháng
model KpiAccountTarget {
  id        String  @id @default(cuid())
  planId    String
  plan      KpiPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  month     Int // 1-12
  amount    Float   @default(0)

  @@unique([planId, accountId, month])
  @@index([accountId])
}

// Phòng ban / nhóm phụ trách dự án và thêm nhiều thành viên trong một lần
model MemberGroup {
  id        String              @id @default(cuid())
  name      String              @unique
  createdAt DateTime            @default(now())
  members   MemberGroupMember[]
  projects  Project[]
}

model MemberGroupMember {
  id        String      @id @default(cuid())
  groupId   String
  userId    String
  group     MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member") // "owner" | "member"
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model ProjectFile {
  id                 String    @id @default(cuid())
  projectId          String?
  uploaderId         String?
  name               String
  mimeType           String
  size               Int
  // Nội dung file khi chưa chuyển lên Google Drive; null khi file đã nằm trên Drive.
  data               Bytes?
  driveFileId        String? // file trên Shared Drive của công ty
  driveSyncStartedAt DateTime? // đang đẩy lên Drive (chống đẩy trùng)
  project            Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader           User?     @relation("ProjectFileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())

  opportunityId       String?
  opportunity         Opportunity? @relation("ProjectFileOpportunity", fields: [opportunityId], references: [id], onDelete: Cascade)
  clientId            String?
  client              Client?      @relation("ProjectFileClient", fields: [clientId], references: [id], onDelete: Restrict)
  sourceOpportunityId String?
  sourceOpportunity   Opportunity? @relation("ProjectFileSourceOpportunity", fields: [sourceOpportunityId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([uploaderId])
}

model Task {
  id              String                  @id @default(cuid())
  title           String
  description     String?
  result          String? // kết quả/bàn giao sau khi hoàn thành công việc
  status          String                  @default("TODO") // "TODO" | "IN_PROGRESS" | "DONE" | "CANCELLED"
  priority        String                  @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"
  startDate       DateTime? // thời gian bắt đầu dự kiến; cùng ngày và trước dueDate
  dueDate         DateTime?
  completedAt     DateTime? // thời điểm chuyển sang DONE — dùng tính đúng hạn/trễ hạn
  order           Float                   @default(0)
  projectId       String?
  project         Project?                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId      String?
  assignee        User?                   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId       String
  creator         User                    @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  comments        Comment[]
  followers       TaskFollower[]
  notifications   Notification[]
  files           TaskFile[]
  recapActionItem MeetingRecapActionItem? // việc cần làm trong biên bản họp đã tạo ra task này
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  opportunityId       String?
  opportunity         Opportunity?      @relation("TaskOpportunity", fields: [opportunityId], references: [id], onDelete: Cascade)
  clientId            String?
  client              Client?           @relation("TaskClient", fields: [clientId], references: [id], onDelete: Restrict)
  sourceOpportunityId String?
  sourceOpportunity   Opportunity?      @relation("TaskSourceOpportunity", fields: [sourceOpportunityId], references: [id], onDelete: SetNull)
  crmKind             String?
  closedReason        String?
  escalatedAt         DateTime?
  reminderTask        ReminderStep[]    @relation("ReminderTask")
  cadenceTask         CadenceReminder[] @relation("CadenceTask")
  taskPostpones       TaskPostpone[]    @relation("TaskPostpones")
  careCampaignTask    CareCampaignTask? @relation("CareCampaignTaskTask")

  @@index([opportunityId, status])
  @@index([clientId, status])
}

// Tệp đính kèm của task — BRIEF khi giao việc, RESULT khi bàn giao kết quả
model TaskFile {
  id                 String    @id @default(cuid())
  taskId             String
  uploaderId         String?
  kind               String // "BRIEF" | "RESULT"
  name               String
  mimeType           String
  size               Int
  // Nội dung file khi chưa chuyển lên Google Drive; null khi file đã nằm trên Drive.
  data               Bytes?
  driveFileId        String?
  driveSyncStartedAt DateTime?
  task               Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader           User?     @relation("TaskFileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())

  @@index([taskId, createdAt])
  @@index([uploaderId])
}

// Người theo dõi task — nhận thông báo khi task có bình luận hoặc thay đổi quan trọng
model TaskFollower {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
}

model Notification {
  id            String       @id @default(cuid())
  dedupeKey     String?      @unique // chống tạo trùng cho thông báo tự động
  userId        String // người nhận
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String // "TASK_ASSIGNED" | "TASK_COMPLETED" | "TASK_UPDATED" | "COMMENT" | "COMMENT_MENTION" | "TASK_FOLLOW" | "DEADLINE_REMINDER" | "RECOGNITION_RECEIVED"
  message       String
  taskId        String?
  task          Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId     String? // để dẫn link tới board
  recognitionId String?
  recognition   Recognition? @relation("RecognitionNotification", fields: [recognitionId], references: [id], onDelete: SetNull)
  meetingId     String? // để dẫn link tới lịch họp
  meeting       Meeting?     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  read          Boolean      @default(false)
  createdAt     DateTime     @default(now())

  clientId      String? // Liên kết khách CRM
  opportunityId String? // Liên kết Cơ hội CRM

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([recognitionId])
  @@index([meetingId])
}

// Lời cảm ơn độc lập với project — dùng để mọi người ghi nhận nhau trong công việc và cuộc sống.
model Recognition {
  id            String               @id @default(cuid())
  senderId      String
  recipientId   String
  message       String
  category      String               @default("KINDNESS") // KINDNESS | SUPPORT | INSPIRATION | CARE | BIRTHDAY
  visibility    String               @default("COMPANY") // COMPANY | PRIVATE
  sender        User                 @relation("RecognitionSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient     User                 @relation("RecognitionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  notifications Notification[]       @relation("RecognitionNotification")
  comments      RecognitionComment[]
  createdAt     DateTime             @default(now())

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@index([visibility, createdAt])
}

// Bình luận dưới một lời cảm ơn trên Kudos Wall.
model RecognitionComment {
  id            String      @id @default(cuid())
  recognitionId String
  recognition   Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime    @default(now())

  @@index([recognitionId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  mentions  Json     @default("[]")
  body      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Bộ đếm đăng nhập sai, lưu theo khóa HMAC của email/IP để không lưu thêm PII.
// Dùng database thay vì bộ nhớ tiến trình để rate limit hoạt động trên nhiều instance.
model LoginRateLimit {
  key             String    @id
  failures        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}

// Bộ hồ sơ dùng chung toàn công ty (hồ sơ mẫu, hồ sơ thanh toán...)
model DocumentSet {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  createdAt   DateTime       @default(now())
  files       DocumentFile[]
  links       DocumentLink[]
}

model DocumentFile {
  id                 String      @id @default(cuid())
  setId              String
  set                DocumentSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  title              String // tên hiển thị do người tải đặt
  fileName           String // tên file gốc, giữ phần mở rộng khi tải về
  mimeType           String
  size               Int
  data               Bytes?
  driveFileId        String?
  driveUrl           String? // Link Google Drive xem nhanh (nếu nhập tay hoặc tuỳ chỉnh)
  driveSyncStartedAt DateTime?
  uploaderId         String?
  uploader           User?       @relation("DocumentFileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt          DateTime    @default(now())

  @@index([setId, createdAt])
  @@index([uploaderId])
}

// Tài liệu dạng đường dẫn (Google Drive, Docs...) trong một bộ hồ sơ
model DocumentLink {
  id        String      @id @default(cuid())
  setId     String
  set       DocumentSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  title     String
  url       String
  creatorId String?
  creator   User?       @relation("DocumentLinkCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([setId, createdAt])
}

// Đơn xin nghỉ phép: quản lý trực tiếp duyệt; chưa có quản lý thì quản lý nghỉ phép duyệt
model LeaveRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  type         String // "ANNUAL" | "UNPAID"
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  halfDay      String? // "AM" | "PM" — chỉ khi nghỉ một ngày
  days         Float // số ngày làm việc được tính (0,5 nếu nghỉ nửa ngày)
  reason       String?
  status       String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "CANCELLED"
  deciderId    String?
  decider      User?     @relation("LeaveDecider", fields: [deciderId], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())

  @@index([userId, startDate])
  @@index([status, startDate])
}

// Điều chỉnh số ngày đã dùng theo năm; đơn đã duyệt vẫn được tính tự động.
model LeaveUsageAdjustment {
  userId         String
  year           Int
  adjustmentDays Float    @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, year])
}

// Phòng họp dùng chung của công ty. Phòng ngừng dùng (isActive = false) không đặt mới được
// nhưng các cuộc họp đã đặt vẫn giữ nguyên.
model MeetingRoom {
  id        String    @id @default(cuid())
  name      String    @unique
  capacity  Int? // sức chứa, chỉ để tham khảo khi chọn phòng
  isActive  Boolean   @default(true)
  meetings  Meeting[]
  createdAt DateTime  @default(now())
}

// Cuộc họp nội bộ. Huỷ họp chỉ đổi status chứ không xoá dòng, nên phòng được trả lại
// ngay (kiểm tra trùng phòng chỉ xét các cuộc họp SCHEDULED) mà vẫn giữ lịch sử.
model Meeting {
  id              String                  @id @default(cuid())
  title           String
  description     String?
  startAt         DateTime
  endAt           DateTime
  status          String                  @default("SCHEDULED") // "SCHEDULED" | "CANCELLED"
  sequence        Int                     @default(0) // tăng mỗi lần sửa/huỷ để lịch trong email cập nhật đúng bản mới nhất
  meetingUrl      String? // link họp online (Meet, Zoom...) do người đặt tự dán
  meetCode        String? // mã phòng Meet "abc-defg-hij" tách từ meetingUrl, dùng cho Chrome extension
  roomId          String?
  room            MeetingRoom?            @relation(fields: [roomId], references: [id], onDelete: SetNull)
  organizerId     String
  organizer       User                    @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  // Người ghi biên bản (phải là người tham dự). Để trống = người tổ chức tự ghi.
  recorderId      String?
  recorder        User?                   @relation("MeetingRecorder", fields: [recorderId], references: [id], onDelete: SetNull)
  attendees       MeetingAttendee[]
  notifications   Notification[]
  recap           MeetingRecap?
  recapRecipients MeetingRecapRecipient[]
  projectId       String? // họp tạo từ trang dự án: biên bản được lưu vào tài liệu dự án
  project         Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // Họp lặp lại: các buổi cùng chuỗi chung seriesId; mỗi buổi vẫn là một cuộc họp riêng.
  seriesId        String?
  seriesFrequency String? // "daily" | "weekly" | "biweekly" | "monthly"
  cancelledAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  opportunityId       String?
  opportunity         Opportunity? @relation("MeetingOpportunity", fields: [opportunityId], references: [id], onDelete: SetNull)
  clientId            String?
  client              Client?      @relation("MeetingClient", fields: [clientId], references: [id], onDelete: SetNull)
  sourceOpportunityId String?
  sourceOpportunity   Opportunity? @relation("MeetingSourceOpportunity", fields: [sourceOpportunityId], references: [id], onDelete: SetNull)

  @@index([seriesId, startAt])
  @@index([status, startAt])
  @@index([roomId, status, startAt])
  @@index([organizerId, startAt])
  @@index([recorderId])
  @@index([projectId])
  @@index([meetCode])
}

model MeetingAttendee {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  response  String   @default("PENDING") // "PENDING" | "ACCEPTED" | "DECLINED"
  createdAt DateTime @default(now())

  @@unique([meetingId, userId])
  @@index([userId])
}

// Biên bản họp: Groq chép lời file ghi âm, Gemini viết biên bản tiếng Việt.
// File ghi âm chỉ nằm tạm trên Vercel Blob và bị xoá ngay khi chép lời xong.
model MeetingRecap {
  id                  String                   @id @default(cuid())
  meetingId           String                   @unique
  meeting             Meeting                  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  status              String                   @default("PROCESSING") // "PROCESSING" | "READY" | "FAILED"
  stage               String? // khi đang xử lý: "TRANSCRIBING" | "SUMMARIZING"
  error               String?
  audioName           String? // tên file gốc người tổ chức tải lên
  audioPathname       String? // đường dẫn file tạm trên Vercel Blob; null khi đã xoá
  audioSeconds        Int?
  transcript          String? // bản chép lời có mốc thời gian
  content             String? // biên bản (AI viết, người tổ chức có thể sửa)
  publishedSnapshot   Json? // bản đã gửi; không đổi khi sửa hoặc viết lại bản nháp
  actionSuggestions   Json                     @default("[]") // đề xuất AI chờ người tổ chức chọn bổ sung
  glossarySuggestions Json                     @default("[]") // từ người sửa tay đã đổi, chờ chọn thêm vào từ điển
  createdById         String?
  createdBy           User?                    @relation("MeetingRecapCreator", fields: [createdById], references: [id], onDelete: SetNull)
  processingStartedAt DateTime?
  sentAt              DateTime? // lúc người tổ chức gửi cho người tham dự; trước đó chỉ người tổ chức/admin xem được
  projectFileId       String? // file biên bản (.docx) đã lưu vào tài liệu dự án, để lần gửi sau thay bản mới
  // Họp không gắn dự án: Google Doc trong thư mục "Biên bản họp/<năm>" trên Shared Drive.
  // Dựng thẳng từ bản đã gửi lúc đẩy lên, không lưu file trong database.
  driveFileId         String?
  driveSyncedSentAt   DateTime? // lần gửi đã có trên Drive; khác sentAt thì cần đẩy lại
  actionItems         MeetingRecapActionItem[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([status, processingStartedAt])
  @@index([createdById])
}

// Người nhận biên bản thêm ngoài danh sách tham dự. Có dòng này thì mở được trang biên bản
// (đọc nội dung sau khi biên bản được gửi); không phải người dự họp nên không nhận lịch họp.
model MeetingRecapRecipient {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("MeetingRecapRecipientUser", fields: [userId], references: [id], onDelete: Cascade)
  addedById String?
  addedBy   User?    @relation("MeetingRecapRecipientAdder", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([meetingId, userId])
  @@index([userId])
}

// Từ điển dùng chung của công ty cho biên bản họp: tên riêng/thuật ngữ đưa vào gợi ý chép lời
// (Groq) và prompt viết biên bản (Gemini); quy tắc viết chỉ dùng cho Gemini.
model RecapGlossaryTerm {
  id          String   @id @default(cuid())
  kind        String   @default("TERM") // "TERM" | "RULE"
  text        String // TERM: cách viết đúng; RULE: câu quy tắc
  heardAs     String? // TERM: cách chép sai hay gặp ("Tuy L" cho "Tuyết Lê")
  useCount    Int      @default(0)
  createdById String?
  createdBy   User?    @relation("RecapGlossaryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([kind, text])
}

// Việc cần làm trong biên bản họp — lưu riêng để gắn người phụ trách, tick đã xong và tạo task.
model MeetingRecapActionItem {
  id        String       @id @default(cuid())
  recapId   String
  recap     MeetingRecap @relation(fields: [recapId], references: [id], onDelete: Cascade)
  order     Int          @default(0)
  title     String
  ownerId   String?
  owner     User?        @relation("MeetingRecapActionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerName String? // tên AI nghe được nhưng chưa khớp với ai trong danh sách mời
  dueDate   DateTime? // 17:00 giờ VN của ngày hạn
  dueText   String? // hạn như được nói trong họp ("cuối tháng") khi chưa đổi được ra ngày
  doneAt    DateTime?
  taskId    String?      @unique // task đã tạo từ việc này; khi đó trạng thái lấy theo task
  task      Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([recapId, order])
  @@index([ownerId])
}

// Nhật ký mỗi lần gọi AI cho biên bản họp — dùng để đếm hạn mức ngày, chặn chạy quá tay.
// Không ràng buộc khoá ngoại để vẫn giữ số liệu khi cuộc họp/biên bản bị xoá.
model MeetingRecapRun {
  id           String   @id @default(cuid())
  meetingId    String
  userId       String?
  kind         String // "TRANSCRIBE" (Groq) | "RETRANSCRIBE" (Groq, chép lại cứu đoạn hỏng) | "SUMMARIZE" (Gemini)
  audioSeconds Int? // với TRANSCRIBE: ước tính trước khi chạy, cập nhật số thật sau khi chép lời
  createdAt    DateTime @default(now())

  @@index([kind, createdAt])
  @@index([meetingId, kind, createdAt])
}

// Kết nối Google Drive chung của app (tài khoản noreply), một dòng duy nhất id = "default".
model GoogleDriveConnection {
  id            String    @id @default("default")
  email         String
  token         String // refresh token đã mã hoá
  scopes        String[]
  connectedById String?
  connectedAt   DateTime  @default(now())
  lastError     String?
  lastErrorAt   DateTime?
}

// Thư mục app đã tạo trên Shared Drive. key: "year:2026", "project:<id>", "project:<id>:docs",

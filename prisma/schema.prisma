generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  name             String
  avatarUrl        String?
  passwordHash     String
  role             String              @default("USER") // "ADMIN" | "ACCOUNT" | "USER"
  isActive         Boolean             @default(true)
  deactivatedAt    DateTime?
  managerId        String? // người quản lý trực tiếp
  manager          User?               @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports          User[]              @relation("TeamManager") // nhân viên dưới quyền
  createdAt        DateTime            @default(now())
  memberships      ProjectMember[]
  ownedProjects    Project[]           @relation("ProjectOwner")
  assignedTasks    Task[]              @relation("TaskAssignee")
  createdTasks     Task[]              @relation("TaskCreator")
  comments         Comment[]
  notifications    Notification[]
  taskFollows      TaskFollower[]
  accountProfile   Account?
  groupMemberships MemberGroupMember[]
  uploadedFiles    ProjectFile[]       @relation("ProjectFileUploader")

  @@index([isActive])
}

model Project {
  id                   String          @id @default(cuid())
  name                 String
  description          String?
  color                String          @default("#6366f1")
  status               String          @default("BIDDING") // "BIDDING" | "ON_PROCESS" | "PENDING" | "DONE" | "CANCEL" | "FAIL"
  revenue              Float           @default(0) // doanh thu dự kiến/thực tế (VND)
  googleChatWebhookUrl String?
  ownerId              String
  owner                User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  clientId             String?
  client               Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  accountId            String?
  account              Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  members              ProjectMember[]
  tasks                Task[]
  files                ProjectFile[]
  onProcessAt          DateTime? // thời điểm đầu tiên chuyển sang ON_PROCESS - dùng ghi nhận doanh thu
  completedAt          DateTime? // thời điểm chuyển sang DONE
  createdAt            DateTime        @default(now())

  @@index([status, onProcessAt])
  @@index([status, completedAt])
}

// Danh mục khách hàng — do admin tạo sẵn
model Client {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  projects  Project[]
}

// Danh mục account (đầu mối phụ trách) — do admin tạo sẵn
model Account {
  id        String    @id @default(cuid())
  name      String
  userId    String?   @unique
  user      User?     @relation(fields: [userId], references: [id], onDelete: Restrict)
  teamId    String
  team      SalesTeam @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now())
  projects  Project[]

  @@index([teamId])
}

// Team kinh doanh — dùng nhóm các Account để theo dõi hiệu suất
model SalesTeam {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  accounts  Account[]
}

// Nhóm nhân sự cố định để thêm nhiều người vào project trong một lần
model MemberGroup {
  id        String              @id @default(cuid())
  name      String              @unique
  createdAt DateTime            @default(now())
  members   MemberGroupMember[]
}

model MemberGroupMember {
  id        String      @id @default(cuid())
  groupId   String
  userId    String
  group     MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member") // "owner" | "member"
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model ProjectFile {
  id         String   @id @default(cuid())
  projectId  String
  uploaderId String?
  name       String
  mimeType   String
  size       Int
  data       Bytes
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader   User?    @relation("ProjectFileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([uploaderId])
}

model Task {
  id            String         @id @default(cuid())
  title         String
  description   String?
  result        String? // kết quả/bàn giao sau khi hoàn thành công việc
  status        String         @default("TODO") // "TODO" | "IN_PROGRESS" | "DONE"
  priority      String         @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"
  dueDate       DateTime?
  completedAt   DateTime? // thời điểm chuyển sang DONE — dùng tính đúng hạn/trễ hạn
  order         Float          @default(0)
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId    String?
  assignee      User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId     String
  creator       User           @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  comments      Comment[]
  followers     TaskFollower[]
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// Người theo dõi task — nhận thông báo khi task có bình luận hoặc thay đổi quan trọng
model TaskFollower {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String // người nhận
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "TASK_ASSIGNED" | "TASK_COMPLETED" | "TASK_UPDATED" | "COMMENT" | "TASK_FOLLOW"
  message   String
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId String? // để dẫn link tới board
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Phase 10 uses append-only relations for settlement and financial close.
// Producer approval, cash, signing, task, and lifecycle states remain unchanged.
model ProjectSettlementDossier {
  id                 String                        @id @default(cuid())
  projectId          String                        @unique
  project            Project                       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdById        String
  createdBy          User                          @relation("SettlementDossierCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime                      @default(now())
  versions           ProjectSettlementVersion[]
  closeRequests      FinancialCloseRequest[]
  correctionAttempts SettlementCorrectionAttempt[]

  @@unique([id, projectId])
  @@index([createdById, createdAt])
}

model ProjectSettlementVersion {
  id                        String                             @id @default(cuid())
  projectId                 String
  project                   Project                            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  dossierId                 String
  dossier                   ProjectSettlementDossier           @relation(fields: [dossierId, projectId], references: [id, projectId], onDelete: Restrict)
  requestId                 String
  request                   WorkflowRequest                    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  version                   Int
  attemptId                 String
  canonicalHash             String
  sourceManifestHash        String?
  approvedAttemptId         String?
  approvedSnapshotId        String?
  approvedSnapshot          WorkflowApprovedSnapshot?          @relation("SettlementVersionApprovedSnapshot", fields: [approvedSnapshotId, requestId], references: [id, requestId], onDelete: Restrict)
  approvedProjectionHash    String?
  createdById               String
  createdBy                 User                               @relation("SettlementVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  supersedesId              String?                            @unique
  supersedes                ProjectSettlementVersion?          @relation("SettlementVersionReplacement", fields: [supersedesId], references: [id], onDelete: Restrict)
  replacedBy                ProjectSettlementVersion?          @relation("SettlementVersionReplacement")
  replacementReason         String?
  replacementActorId        String?
  replacementActor          User?                              @relation("SettlementReplacementActor", fields: [replacementActorId], references: [id], onDelete: Restrict)
  replacedAt                DateTime?
  createdAt                 DateTime                           @default(now())
  obligations               SettlementRecipientObligation[]
  locks                     SettlementLock[]
  evidence                  SettlementEvidence[]
  exports                   SettlementExportAudit[]
  advanceManifestRows       SettlementAdvanceManifestRow[]
  correctionBaseAttempts    SettlementCorrectionAttempt[]      @relation("SettlementCorrectionBaseVersion")
  correctionVersionAttempts SettlementCorrectionAttempt[]      @relation("SettlementCorrectionVersion")
  exportSourceProjections   SettlementExportSourceProjection[]
  closeRequests             FinancialCloseRequest[]

  @@unique([dossierId, version])
  @@unique([projectId, attemptId])
  @@unique([id, projectId])
  @@index([projectId, createdAt])
  @@index([requestId])
  @@index([replacementActorId, replacedAt])
}

model SettlementRecipientObligation {
  id                      String                               @id @default(cuid())
  projectId               String
  project                 Project                              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  dossierVersionId        String
  dossierVersion          ProjectSettlementVersion             @relation(fields: [dossierVersionId, projectId], references: [id, projectId], onDelete: Restrict)
  recipientKey            String
  recipientType           String
  direction               String
  approvedAcGross         String
  disbursedAdvance        String
  amountDue               String
  createdAt               DateTime                             @default(now())
  cashAllocations         SettlementCashAllocation[]
  locks                   SettlementLock[]
  correctionOriginalPairs SettlementCorrectionObligationPair[] @relation("SettlementCorrectionOriginalObligation")
  correctionRecoveryPairs SettlementCorrectionObligationPair[] @relation("SettlementCorrectionRecoveryObligation")
  correctionPaymentPairs  SettlementCorrectionObligationPair[] @relation("SettlementCorrectionPaymentObligation")
  advanceManifestRows     SettlementAdvanceManifestRow[]

  @@unique([dossierVersionId, recipientKey])
  @@unique([id, projectId])
  @@unique([id, projectId, recipientKey])
  @@index([projectId, recipientKey])
}

model SettlementCashAllocation {
  id                 String                        @id @default(cuid())
  projectId          String
  project            Project                       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  obligationId       String
  recipientKey       String
  obligation         SettlementRecipientObligation @relation(fields: [obligationId, projectId, recipientKey], references: [id, projectId, recipientKey], onDelete: Restrict)
  cashId             String
  cash               CostFlowCash                  @relation(fields: [cashId, projectId, recipientKey], references: [id, projectId, recipientKey], onDelete: Restrict)
  amount             String
  idempotencyKey     String
  commandFingerprint String
  createdAt          DateTime                      @default(now())

  @@unique([projectId, idempotencyKey])
  @@unique([cashId, obligationId])
  @@index([projectId, obligationId, recipientKey])
}

model SettlementLock {
  id                      String                        @id @default(cuid())
  projectId               String
  project                 Project                       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  dossierVersionId        String
  dossierVersion          ProjectSettlementVersion      @relation(fields: [dossierVersionId, projectId], references: [id, projectId], onDelete: Restrict)
  obligationId            String
  recipientKey            String
  obligation              SettlementRecipientObligation @relation(fields: [obligationId, projectId, recipientKey], references: [id, projectId, recipientKey], onDelete: Restrict)
  actualCostApplicationId String?                       @unique
  actualCostApplication   ActualCostApplication?        @relation(fields: [actualCostApplicationId, projectId, recipientKey], references: [id, projectId, recipientKey], onDelete: Restrict)
  advanceApplicationId    String?                       @unique
  advanceApplication      AdvanceApplication?           @relation(fields: [advanceApplicationId, projectId, recipientKey], references: [id, projectId, recipientKey], onDelete: Restrict)
  sourceCashAllocationId  String?
  sourceCashAllocation    CostFlowCashAllocation?       @relation(fields: [sourceCashAllocationId, projectId, recipientKey], references: [id, projectId, recipientKey], onDelete: Restrict)
  lockedAt                DateTime                      @default(now())

  @@unique([dossierVersionId, actualCostApplicationId])
  @@unique([dossierVersionId, advanceApplicationId])
  @@index([projectId, obligationId, recipientKey])
  @@index([sourceCashAllocationId])
}

model SettlementEvidence {
  id               String                   @id @default(cuid())
  projectId        String
  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  dossierVersionId String
  dossierVersion   ProjectSettlementVersion @relation(fields: [dossierVersionId, projectId], references: [id, projectId], onDelete: Restrict)
  evidenceId       String
  evidence         CostFlowEvidence         @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  kind             String
  sha256           String
  addedById        String
  addedBy          User                     @relation("SettlementEvidenceActor", fields: [addedById], references: [id], onDelete: Restrict)
  createdAt        DateTime                 @default(now())

  @@unique([dossierVersionId, evidenceId, kind])
  @@index([projectId, dossierVersionId])
  @@index([addedById, createdAt])
}

model FinancialCloseRequest {
  id               String                    @id @default(cuid())
  projectId        String
  project          Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  dossierId        String
  dossier          ProjectSettlementDossier  @relation(fields: [dossierId, projectId], references: [id, projectId], onDelete: Restrict)
  dossierVersionId String?
  dossierVersion   ProjectSettlementVersion? @relation(fields: [dossierVersionId, projectId], references: [id, projectId], onDelete: Restrict)
  canonicalHash    String?
  workspaceVersion Int?
  attemptId        String
  action           String
  reason           String
  requestedById    String
  requestedBy      User                      @relation("FinancialCloseRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  createdAt        DateTime                  @default(now())
  events           FinancialCloseEvent[]

  @@unique([projectId, attemptId])
  @@index([projectId, action, createdAt])
  @@index([requestedById, createdAt])
}

model FinancialCloseEvent {
  id             String                @id @default(cuid())
  closeRequestId String
  closeRequest   FinancialCloseRequest @relation(fields: [closeRequestId], references: [id], onDelete: Restrict)
  decision       String
  reason         String
  actorId        String
  actor          User                  @relation("FinancialCloseEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  eventHash      String                @unique
  createdAt      DateTime              @default(now())

  @@index([closeRequestId, createdAt])
  @@index([actorId, createdAt])
}

model SettlementExportAudit {
  id                 String                                @id @default(cuid())
  projectId          String
  project            Project                               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  dossierVersionId   String?
  dossierVersion     ProjectSettlementVersion?             @relation(fields: [dossierVersionId], references: [id], onDelete: Restrict)
  family             String
  format             String
  canonicalHash      String
  approvalAttemptId  String?
  sourceProjectionId String?
  sourceProjection   SettlementExportSourceProjection?     @relation(fields: [sourceProjectionId, projectId], references: [id, projectId], onDelete: Restrict)
  sourceKind         String?
  sourceId           String?
  sourceVersion      Int?
  artifactStatus     String                                @default("RESERVED")
  artifactBytes      Bytes?
  artifactByteLength Int?
  reservationToken   String?
  fileSha256         String?
  approvedSnapshotId String?
  approvedSnapshot   WorkflowApprovedSnapshot?             @relation(fields: [approvedSnapshotId], references: [id], onDelete: Restrict)
  publicCapability   WorkflowPublicVerificationCapability?
  idempotencyKey     String
  createdById        String
  createdBy          User                                  @relation("SettlementExportActor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime                              @default(now())

  @@unique([projectId, idempotencyKey])
  @@index([dossierVersionId, family, format])
  @@index([approvedSnapshotId])
  @@index([createdById, createdAt])
}

model SettlementAdvanceManifestRow {
  id                     String                        @id @default(cuid())
  projectId              String
  project                Project                       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  dossierVersionId       String
  dossierVersion         ProjectSettlementVersion      @relation(fields: [dossierVersionId, projectId], references: [id, projectId], onDelete: Restrict)
  obligationId           String
  recipientKey           String
  obligation             SettlementRecipientObligation @relation(fields: [obligationId, projectId, recipientKey], references: [id, projectId, recipientKey], onDelete: Restrict)
  advanceApplicationId   String
  advanceApplication     AdvanceApplication            @relation(fields: [advanceApplicationId, projectId, recipientKey], references: [id, projectId, recipientKey], onDelete: Restrict)
  sourceCashAllocationId String
  sourceCashAllocation   CostFlowCashAllocation        @relation(fields: [sourceCashAllocationId, projectId, recipientKey], references: [id, projectId, recipientKey], onDelete: Restrict)
  createdAt              DateTime                      @default(now())

  @@unique([dossierVersionId, advanceApplicationId, sourceCashAllocationId])
  @@index([projectId, obligationId, recipientKey])
}

model SettlementCorrectionAttempt {
  id                   String                               @id @default(cuid())
  projectId            String
  project              Project                              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  dossierId            String
  dossier              ProjectSettlementDossier             @relation(fields: [dossierId, projectId], references: [id, projectId], onDelete: Restrict)
  baseVersionId        String
  baseVersion          ProjectSettlementVersion             @relation("SettlementCorrectionBaseVersion", fields: [baseVersionId, projectId], references: [id, projectId], onDelete: Restrict)
  correctionVersionId  String?                              @unique
  correctionVersion    ProjectSettlementVersion?            @relation("SettlementCorrectionVersion", fields: [correctionVersionId, projectId], references: [id, projectId], onDelete: Restrict)
  requestedFieldScopes Json
  requestedLockScopes  Json
  requestedById        String
  requestedBy          User                                 @relation("SettlementCorrectionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reason               String
  stage                String
  status               String                               @default("OPEN")
  terminalAt           DateTime?
  createdAt            DateTime                             @default(now())
  updatedAt            DateTime                             @updatedAt
  obligationPairs      SettlementCorrectionObligationPair[]

  @@unique([id, projectId])
  @@index([projectId, createdAt])
  @@index([dossierId, createdAt])
}

model SettlementCorrectionObligationPair {
  id                           String                        @id @default(cuid())
  projectId                    String
  project                      Project                       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  correctionAttemptId          String
  correctionAttempt            SettlementCorrectionAttempt   @relation(fields: [correctionAttemptId, projectId], references: [id, projectId], onDelete: Restrict)
  originalObligationId         String
  originalObligation           SettlementRecipientObligation @relation("SettlementCorrectionOriginalObligation", fields: [originalObligationId, projectId], references: [id, projectId], onDelete: Restrict)
  recoveryObligationId         String
  recoveryObligation           SettlementRecipientObligation @relation("SettlementCorrectionRecoveryObligation", fields: [recoveryObligationId, projectId], references: [id, projectId], onDelete: Restrict)
  correctedPaymentObligationId String
  correctedPaymentObligation   SettlementRecipientObligation @relation("SettlementCorrectionPaymentObligation", fields: [correctedPaymentObligationId, projectId], references: [id, projectId], onDelete: Restrict)
  createdAt                    DateTime                      @default(now())

  @@unique([correctionAttemptId, originalObligationId])
  @@unique([recoveryObligationId])
  @@unique([correctedPaymentObligationId])
  @@index([projectId, createdAt])
}

model SettlementExportSourceProjection {
  id                 String                    @id @default(cuid())
  projectId          String
  project            Project                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  dossierVersionId   String?
  dossierVersion     ProjectSettlementVersion? @relation(fields: [dossierVersionId, projectId], references: [id, projectId], onDelete: Restrict, map: "SettlementExportProjection_dossier_project_fkey")
  family             String
  sourceKind         String
  sourceId           String
  sourceVersion      Int
  authoritativeNet   String
  authoritativeVat   String
  authoritativeGross String
  roundingAdjustment Int
  vatLineAssignment  Json
  projectionHash     String
  approvalAttemptId  String?
  approvedSnapshotId String?
  signingState       String?
  canonicalPayload   Json?
  createdAt          DateTime                  @default(now())
  audits             SettlementExportAudit[]

  @@unique([projectId, family, sourceKind, sourceId, sourceVersion], map: "SettlementExportSourceProjection_exact_source_key")
  @@unique([id, projectId])
  @@index([dossierVersionId, family])
}

model CostFlowHistory {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  version   Int
  actorId   String
  action    String
  snapshot  Json
  createdAt DateTime @default(now())

  @@unique([projectId, version])
}

// Phase 15 AI records are append-only provenance and advisory state. They do
// not own approval, cash, signing, task completion, or financial-close state.
model AiSourceRevision {
  id             String                   @id @default(cuid())
  projectId      String?
  project        Project?                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  scopeKey       String
  originKind     String
  originId       String
  originVersion  String
  sha256         String
  filename       String
  mimeType       String
  byteLength     Int
  authorityStatus String
  snapshotBytes  Bytes?
  createdById    String
  createdBy      User                     @relation("AiSourceRevisionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime                 @default(now())
  spans          AiSourceSpan[]
  runSources     AiRunSource[]
  publications   AiKnowledgePublication[]

  @@unique([originKind, originId, originVersion, sha256])
  @@unique([id, scopeKey])
  @@index([projectId, authorityStatus, createdAt])
  @@index([sha256, createdAt])
  @@index([createdById, createdAt])
}

model AiSourceSpan {
  id               String             @id @default(cuid())
  sourceRevisionId String
  scopeKey         String
  sourceRevision   AiSourceRevision   @relation(fields: [sourceRevisionId, scopeKey], references: [id, scopeKey], onDelete: Restrict)
  spanKind         String
  pageNumber       Int?
  sheetName        String?
  cellRange        String?
  xmlPath          String?
  textStart        Int?
  textEnd          Int?
  quote            String
  normalizedText   String
  contentHash      String
  createdAt        DateTime           @default(now())
  candidateFields  AiCandidateField[]
  findings         AiFinding[]
  knowledgeChunks  AiKnowledgeChunk[]

  @@unique([sourceRevisionId, contentHash])
  @@unique([id, scopeKey])
  @@index([sourceRevisionId, spanKind])
  @@index([contentHash])
}

model AiRun {
  id               String                 @id @default(cuid())
  projectId        String?
  project          Project?               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actorId          String
  actor            User                   @relation("AiRunActor", fields: [actorId], references: [id], onDelete: Restrict)
  scopeKey         String
  runType          String
  status           String
  sourceBundleHash String
  parserVersion    String
  pipelineVersion  String
  promptVersion    String
  configVersion    String
  provider         String
  model            String
  scopeVersion     String
  scopeHash        String
  idempotencyKey   String
  startedAt        DateTime               @default(now())
  timeoutAt        DateTime?
  cancelledAt      DateTime?
  completedAt      DateTime?
  failureCode      String?
  outcomeCode      String?
  reviewStatus     String                 @default("PENDING")
  inputTokens      Int?
  outputTokens     Int?
  providerRequestId String?
  latencyMs        Int?
  createdAt        DateTime               @default(now())
  sources          AiRunSource[]
  candidateFields  AiCandidateField[]
  findings         AiFinding[]
  reviewEvents     AiReviewEvent[]
  applicationReceipts AiApplicationReceipt[]
  mappingAdapters  AiMappingAdapter[]

  @@unique([scopeKey, runType, idempotencyKey])
  @@unique([id, scopeKey])
  @@index([projectId, status, createdAt])
  @@index([actorId, status, createdAt])
  @@index([sourceBundleHash, configVersion])
  @@index([scopeHash, createdAt])
}

model AiRunSource {
  id               String           @id @default(cuid())
  runId            String
  sourceRevisionId String
  scopeKey         String
  role             String
  createdAt        DateTime         @default(now())
  run              AiRun            @relation(fields: [runId, scopeKey], references: [id, scopeKey], onDelete: Restrict)
  sourceRevision   AiSourceRevision @relation(fields: [sourceRevisionId, scopeKey], references: [id, scopeKey], onDelete: Restrict)

  @@unique([runId, sourceRevisionId, role])
  @@index([sourceRevisionId, role])
  @@index([scopeKey, createdAt])
}

model AiCandidateField {
  id             String        @id @default(cuid())
  runId          String
  scopeKey       String
  run            AiRun         @relation(fields: [runId, scopeKey], references: [id, scopeKey], onDelete: Restrict)
  rowKey         String
  fieldKey       String
  aiValue        String?
  rawValue       String?
  correctedValue String?
  manualValue    String?
  provenance     String
  confidence     String?
  sourceSpanId   String?
  sourceSpan     AiSourceSpan? @relation(fields: [sourceSpanId, scopeKey], references: [id, scopeKey], onDelete: Restrict)
  reviewStatus   String        @default("PENDING")
  reviewedById   String?
  reviewedBy     User?         @relation("AiCandidateReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt     DateTime?
  reason         String?
  createdAt      DateTime      @default(now())
  reviewEvents   AiReviewEvent[]

  @@unique([runId, rowKey, fieldKey])
  @@unique([id, scopeKey])
  @@index([runId, reviewStatus, createdAt])
  @@index([reviewedById, reviewedAt])
  @@index([sourceSpanId])
}

model AiFinding {
  id               String          @id @default(cuid())
  runId            String
  projectId        String
  scopeKey         String
  run              AiRun           @relation(fields: [runId, scopeKey], references: [id, scopeKey], onDelete: Restrict)
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  kind             String
  ruleCode         String?
  ruleVersion      String?
  targetKind       String
  targetId         String
  sourceSpanId     String?
  sourceSpan       AiSourceSpan?   @relation(fields: [sourceSpanId, scopeKey], references: [id, scopeKey], onDelete: Restrict)
  ownerId          String?
  owner            User?           @relation("AiFindingOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  route            String
  status           String          @default("OPEN")
  resolutionReason String?
  resolvedById     String?
  resolvedBy       User?           @relation("AiFindingResolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedAt       DateTime?
  createdAt        DateTime        @default(now())
  reviewEvents     AiReviewEvent[]

  @@unique([id, scopeKey])
  @@index([projectId, status, createdAt])
  @@index([ownerId, status, createdAt])
  @@index([runId, kind, createdAt])
  @@index([sourceSpanId])
}

model AiReviewEvent {
  id               String            @id @default(cuid())
  runId            String
  scopeKey         String
  run              AiRun             @relation(fields: [runId, scopeKey], references: [id, scopeKey], onDelete: Restrict)
  candidateFieldId String?
  candidateField   AiCandidateField? @relation(fields: [candidateFieldId, scopeKey], references: [id, scopeKey], onDelete: Restrict)
  findingId        String?
  finding          AiFinding?        @relation(fields: [findingId, scopeKey], references: [id, scopeKey], onDelete: Restrict)
  targetKind       String
  targetId         String
  action           String
  beforeValue      Json?
  afterValue       Json?
  actorId          String
  actor            User              @relation("AiReviewEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  reason           String
  createdAt        DateTime          @default(now())

  @@index([runId, targetKind, targetId, createdAt])
  @@index([candidateFieldId, createdAt])
  @@index([findingId, createdAt])
  @@index([actorId, createdAt])
}

model AiApplicationReceipt {
  id                  String   @id @default(cuid())
  runId               String
  scopeKey            String
  run                 AiRun    @relation(fields: [runId, scopeKey], references: [id, scopeKey], onDelete: Restrict)
  targetKind          String
  targetId            String
  targetVersionBefore String
  targetVersionAfter  String
  beforeHash          String
  afterHash           String
  fieldDecisions      Json
  actorId             String
  actor               User     @relation("AiApplicationReceiptActor", fields: [actorId], references: [id], onDelete: Restrict)
  idempotencyKey      String
  createdAt           DateTime @default(now())

  @@unique([scopeKey, idempotencyKey])
  @@index([runId, targetKind, targetId, createdAt])
  @@index([actorId, createdAt])
}

// Explicit PO/VAT business drafts. Applying reviewed AI fields changes only
// these drafts; existing PO confirmation and registered VAT invoice flows stay separate.
model DocumentIntakeDraft {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  kind        String
  status      String   @default("DRAFT")
  version     Int      @default(1)
  fields      Json     @default("{}")
  createdById String
  createdBy   User     @relation("DocumentIntakeDraftCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, kind, status, updatedAt])
  @@index([createdById, updatedAt])
}

model AiKnowledgePublication {
  id                 String                    @id @default(cuid())
  sourceRevisionId   String
  scopeKey           String
  sourceRevision     AiSourceRevision          @relation(fields: [sourceRevisionId, scopeKey], references: [id, scopeKey], onDelete: Restrict)
  publicationVersion Int
  status             String
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  publishedById      String
  publishedBy        User                      @relation("AiKnowledgePublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  publishedAt        DateTime?
  supersedesId       String?                   @unique
  supersedes         AiKnowledgePublication?   @relation("AiKnowledgePublicationReplacement", fields: [supersedesId], references: [id], onDelete: Restrict)
  replacedBy         AiKnowledgePublication?   @relation("AiKnowledgePublicationReplacement")
  createdAt          DateTime                  @default(now())
  chunks             AiKnowledgeChunk[]

  @@unique([sourceRevisionId, publicationVersion])
  @@unique([id, scopeKey])
  @@index([status, effectiveFrom, effectiveTo])
  @@index([publishedById, publishedAt])
}

model AiKnowledgeChunk {
  id             String                 @id @default(cuid())
  publicationId  String
  sourceSpanId   String
  scopeKey       String
  publication    AiKnowledgePublication @relation(fields: [publicationId, scopeKey], references: [id, scopeKey], onDelete: Restrict)
  sourceSpan     AiSourceSpan            @relation(fields: [sourceSpanId, scopeKey], references: [id, scopeKey], onDelete: Restrict)
  chunkIndex     Int
  normalizedText String
  contentHash    String
  createdAt      DateTime               @default(now())

  @@unique([publicationId, chunkIndex])
  @@index([sourceSpanId])
  @@index([contentHash])
}

model AiMappingAdapter {
  id                   String            @id @default(cuid())
  projectId            String?
  project              Project?          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  scopeKey             String
  structureFingerprint String
  adapterVersion       String
  mapping              Json
  confirmedRunId       String
  confirmedRun         AiRun             @relation(fields: [confirmedRunId, scopeKey], references: [id, scopeKey], onDelete: Restrict)
  confirmedById        String
  confirmedBy          User              @relation("AiMappingConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  status               String            @default("ACTIVE")
  supersedesId         String?           @unique
  supersedes           AiMappingAdapter? @relation("AiMappingAdapterReplacement", fields: [supersedesId], references: [id], onDelete: Restrict)
  replacedBy           AiMappingAdapter? @relation("AiMappingAdapterReplacement")
  createdAt            DateTime          @default(now())

  @@unique([structureFingerprint, adapterVersion])
  @@unique([id, scopeKey])
  @@index([projectId, status, createdAt])
  @@index([confirmedById, createdAt])
  @@index([confirmedRunId])
}

// Bộ hồ sơ dùng chung toàn công ty (hồ sơ mẫu, hồ sơ thanh toán...)
model DocumentSet {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  createdAt   DateTime       @default(now())
  files       DocumentFile[]
  links       DocumentLink[]
}

model DocumentFile {
  id                 String      @id @default(cuid())
  setId              String
  set                DocumentSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  title              String // tên hiển thị do người tải đặt
  fileName           String // tên file gốc, giữ phần mở rộng khi tải về
  mimeType           String
  size               Int
  data               Bytes?
  driveFileId        String?
  driveUrl           String? // Link Google Drive xem nhanh (nếu nhập tay hoặc tuỳ chỉnh)
  driveSyncStartedAt DateTime?
  uploaderId         String?
  uploader           User?       @relation("DocumentFileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt          DateTime    @default(now())

  @@index([setId, createdAt])
  @@index([uploaderId])
}

// Tài liệu dạng đường dẫn (Google Drive, Docs...) trong một bộ hồ sơ
model DocumentLink {
  id        String      @id @default(cuid())
  setId     String
  set       DocumentSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  title     String
  url       String
  creatorId String?
  creator   User?       @relation("DocumentLinkCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([setId, createdAt])
}

// Đơn xin nghỉ phép: quản lý trực tiếp duyệt; chưa có quản lý thì quản lý nghỉ phép duyệt
model LeaveRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  type         String // "ANNUAL" | "UNPAID"
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  halfDay      String? // "AM" | "PM" — chỉ khi nghỉ một ngày
  days         Float // số ngày làm việc được tính (0,5 nếu nghỉ nửa ngày)
  reason       String?
  status       String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "CANCELLED"
  deciderId    String?
  decider      User?     @relation("LeaveDecider", fields: [deciderId], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())

  @@index([userId, startDate])
  @@index([status, startDate])
}

// Điều chỉnh số ngày đã dùng theo năm; đơn đã duyệt vẫn được tính tự động.
model LeaveUsageAdjustment {
  userId         String
  year           Int
  adjustmentDays Float    @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, year])
}

// Phòng họp dùng chung của công ty. Phòng ngừng dùng (isActive = false) không đặt mới được
// nhưng các cuộc họp đã đặt vẫn giữ nguyên.
model MeetingRoom {
  id        String    @id @default(cuid())
  name      String    @unique
  capacity  Int? // sức chứa, chỉ để tham khảo khi chọn phòng
  isActive  Boolean   @default(true)
  meetings  Meeting[]
  createdAt DateTime  @default(now())
}

// Cuộc họp nội bộ. Huỷ họp chỉ đổi status chứ không xoá dòng, nên phòng được trả lại
// ngay (kiểm tra trùng phòng chỉ xét các cuộc họp SCHEDULED) mà vẫn giữ lịch sử.
model Meeting {
  id            String            @id @default(cuid())
  title         String
  description   String?
  startAt       DateTime
  endAt         DateTime
  status        String            @default("SCHEDULED") // "SCHEDULED" | "CANCELLED"
  sequence      Int               @default(0) // tăng mỗi lần sửa/huỷ để lịch trong email cập nhật đúng bản mới nhất
  meetingUrl    String? // link họp online (Meet, Zoom...) do người đặt tự dán
  meetCode      String? // mã phòng Meet "abc-defg-hij" tách từ meetingUrl, dùng cho Chrome extension
  roomId        String?
  room          MeetingRoom?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  organizerId   String
  organizer     User              @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  // Người ghi biên bản (phải là người tham dự). Để trống = người tổ chức tự ghi.
  recorderId    String?
  recorder      User?             @relation("MeetingRecorder", fields: [recorderId], references: [id], onDelete: SetNull)
  attendees     MeetingAttendee[]
  notifications Notification[]
  recap         MeetingRecap?
  projectId     String? // họp tạo từ trang dự án: biên bản được lưu vào tài liệu dự án
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  cancelledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, startAt])
  @@index([roomId, status, startAt])
  @@index([organizerId, startAt])
  @@index([recorderId])
  @@index([projectId])
  @@index([meetCode])
}

model MeetingAttendee {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  response  String   @default("PENDING") // "PENDING" | "ACCEPTED" | "DECLINED"
  createdAt DateTime @default(now())

  @@unique([meetingId, userId])
  @@index([userId])
}

// Biên bản họp: Groq chép lời file ghi âm, Gemini viết biên bản tiếng Việt.
// File ghi âm chỉ nằm tạm trên Vercel Blob và bị xoá ngay khi chép lời xong.
model MeetingRecap {
  id                  String                   @id @default(cuid())
  meetingId           String                   @unique
  meeting             Meeting                  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  status              String                   @default("PROCESSING") // "PROCESSING" | "READY" | "FAILED"
  stage               String? // khi đang xử lý: "TRANSCRIBING" | "SUMMARIZING"
  error               String?
  audioName           String? // tên file gốc người tổ chức tải lên
  audioPathname       String? // đường dẫn file tạm trên Vercel Blob; null khi đã xoá
  audioSeconds        Int?
  transcript          String? // bản chép lời có mốc thời gian
  content             String? // biên bản (AI viết, người tổ chức có thể sửa)
  publishedSnapshot   Json? // bản đã gửi; không đổi khi sửa hoặc viết lại bản nháp
  actionSuggestions   Json                     @default("[]") // đề xuất AI chờ người tổ chức chọn bổ sung
  createdById         String?
  createdBy           User?                    @relation("MeetingRecapCreator", fields: [createdById], references: [id], onDelete: SetNull)
  processingStartedAt DateTime?
  sentAt              DateTime? // lúc người tổ chức gửi cho người tham dự; trước đó chỉ người tổ chức/admin xem được
  projectFileId       String? // file biên bản (.docx) đã lưu vào tài liệu dự án, để lần gửi sau thay bản mới
  actionItems         MeetingRecapActionItem[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([status, processingStartedAt])
  @@index([createdById])
}

// Việc cần làm trong biên bản họp — lưu riêng để gắn người phụ trách, tick đã xong và tạo task.
model MeetingRecapActionItem {
  id        String       @id @default(cuid())
  recapId   String
  recap     MeetingRecap @relation(fields: [recapId], references: [id], onDelete: Cascade)
  order     Int          @default(0)
  title     String
  ownerId   String?
  owner     User?        @relation("MeetingRecapActionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerName String? // tên AI nghe được nhưng chưa khớp với ai trong danh sách mời
  dueDate   DateTime? // 17:00 giờ VN của ngày hạn
  dueText   String? // hạn như được nói trong họp ("cuối tháng") khi chưa đổi được ra ngày
  doneAt    DateTime?
  taskId    String?      @unique // task đã tạo từ việc này; khi đó trạng thái lấy theo task
  task      Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([recapId, order])
  @@index([ownerId])
}

// Nhật ký mỗi lần gọi AI cho biên bản họp — dùng để đếm hạn mức ngày, chặn chạy quá tay.
// Không ràng buộc khoá ngoại để vẫn giữ số liệu khi cuộc họp/biên bản bị xoá.
model MeetingRecapRun {
  id           String   @id @default(cuid())
  meetingId    String
  userId       String?
  kind         String // "TRANSCRIBE" (Groq) | "RETRANSCRIBE" (Groq, chép lại cứu đoạn hỏng) | "SUMMARIZE" (Gemini)
  audioSeconds Int? // với TRANSCRIBE: ước tính trước khi chạy, cập nhật số thật sau khi chép lời
  createdAt    DateTime @default(now())

  @@index([kind, createdAt])
  @@index([meetingId, kind, createdAt])
}

// Kết nối Google Drive chung của app (tài khoản noreply), một dòng duy nhất id = "default".
model GoogleDriveConnection {
  id            String    @id @default("default")
  email         String
  token         String // refresh token đã mã hoá
  scopes        String[]
  connectedById String?
  connectedAt   DateTime  @default(now())
  lastError     String?
  lastErrorAt   DateTime?
}

// Thư mục app đã tạo trên Shared Drive. key: "year:2026", "project:<id>", "project:<id>:docs",
// "project:<id>:tasks", "task:<id>". Không gắn khoá ngoại để thư mục vẫn còn khi xoá dự án/task.
model DriveFolder {
  key       String   @id
  folderId  String   @unique
  name      String
  updatedAt DateTime @updatedAt
}

// Hồ sơ nhân sự do HR quản lý. Chỉ Admin và người phụ trách nhân sự xem/sửa được
// (lib/employeeRecords.ts canManageHr). Không ghi các trường này ra log.
model EmployeeRecord {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation("EmployeeRecordOwner", fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  employeeCode String? // mã nhân sự bên phần mềm HR, ví dụ NV043
  dateOfBirth  DateTime? @db.Date
  gender       String? // MALE | FEMALE | OTHER
  idNumber     String? // số CCCD/CMND
  address      String?
  phone        String?
  startDate    DateTime? @db.Date // ngày bắt đầu làm việc
  updatedById  String?
  updatedBy    User?     @relation("EmployeeRecordUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Token xác thực cho Chrome Extension "1 click ghi biên bản"
model ExtensionToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique // sha256 của token; token gốc chỉ trả về một lần khi kết nối
  label      String // Tên thiết bị/trình duyệt, ví dụ: "Chrome trên MacBook của An"
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ==========================================
// GÓC ĐỌC & CẢM HỨNG (CREATIVE CORNER)
// ==========================================

model CreativeArticle {
  id                  String           @id @default(cuid())
  slug                String           @unique
  guid                String           @unique // Mã RSS tránh trùng lặp khi cào lại
  originalUrl         String           // Link gốc bài viết trên davetrott.co.uk
  originalTitle       String           // Tiêu đề tiếng Anh gốc (IN HOA)
  originalPublishedAt DateTime?        // Ngày Dave Trott viết bài

  // Mảng dòng gốc: [{ "t": "Many years ago..." }, { "gap": true }, { "t": "**Off you go.**" }]
  originalLines       Json
  wordCount           Int

  titleVi             String?          // Tiêu đề tiếng Việt (IN HOA)
  // Mảng dòng dịch: Khớp chính xác 1:1 số dòng và vị trí gap với originalLines
  linesVi             Json?
  tags                String[]         @default([]) // Thẻ chủ đề: "sangtao", "tuduy", "copywriting"...

  status              String           @default("DRAFT") // DRAFT | REVIEW | SCHEDULED | PUBLISHED | HIDDEN
  publishedDate       DateTime?        @db.Date          // Ngày phát hành trong app (Thứ 2 - Thứ 6)

  reviewedById        String?
  reviewedBy          User?            @relation("CreativeArticleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  readers             ArticleReader[]  // Lịch sử tương tác của nhân viên
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([status, publishedDate])
}

// Theo dõi từng thành viên: đã đọc, thả tim, lưu bài
model ArticleReader {
  userId     String
  articleId  String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  article    CreativeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  readAt     DateTime?
  likedAt    DateTime?
  savedAt    DateTime?
  updatedAt  DateTime        @updatedAt

  @@id([userId, articleId])
  @@index([articleId])
  @@index([userId, savedAt])
}

// Bàn cờ Caro 15x15 mini game nội bộ
model CaroGame {
  id          String   @id @default(cuid())
  code        String   @unique
  playerXName String   @default("Người chơi 1")
  playerOName String?
  boardState  Json     // Mảng 15x15
  lastMove    Json?    // { r, c }
  turn        String   @default("X") // "X" | "O"
  winner      String?  // "X" | "O" | "DRAW"
  winningLine Json?    // [{ r, c }]
  status      String   @default("WAITING") // WAITING | PLAYING | FINISHED
  scoreX      Int      @default(0)
  scoreO      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
}


// Sudoku 9x9 mini game nội bộ: phòng đua giải online, 2 người cùng giải một đề
model SudokuGame {
  id            String    @id @default(cuid())
  code          String    @unique
  hostUserId    String
  hostName      String
  guestUserId   String?
  guestName     String?
  difficulty    String    @default("medium") // easy | medium | hard | expert
  timerEnabled  Boolean   @default(true)
  timeLimitSec  Int       @default(900)
  puzzle        Json?     // number[81], 0 = ô trống
  solution      Json?     // number[81], không bao giờ gửi về trình duyệt
  hostValues    Json?     // number[81] các ô chủ phòng đã điền đúng
  guestValues   Json?
  hostMistakes  Int       @default(0)
  guestMistakes Int       @default(0)
  status        String    @default("WAITING") // WAITING | READY | PLAYING | FINISHED
  winner        String?   // HOST | GUEST | DRAW
  finishReason  String?   // SOLVED | MISTAKES | TIMEOUT | FORFEIT
  scoreHost     Int       @default(0)
  scoreGuest    Int       @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Kết quả từng trận Sudoku online, dùng cho bảng xếp hạng theo tháng
model SudokuMatch {
  id           String   @id @default(cuid())
  roomCode     String
  hostUserId   String
  guestUserId  String
  winnerUserId String?  // null = hoà
  difficulty   String
  finishReason String   // SOLVED | MISTAKES | TIMEOUT | FORFEIT
  durationSec  Int
  finishedAt   DateTime @default(now())

  @@index([finishedAt])
}

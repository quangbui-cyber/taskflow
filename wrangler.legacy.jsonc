{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taskflow-legacy",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "TZ": "Asia/Ho_Chi_Minh"
  }
}

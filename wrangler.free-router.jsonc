{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taskflow",
  "main": "cloudflare/free-router.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "LEGACY",
      "service": "taskflow-legacy"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EVIDENCE_OBJECTS",
        "class_name": "EvidenceObject",
        "script_name": "taskflow-evidence"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "TZ": "Asia/Ho_Chi_Minh"
  }
}
